# Server Configuration
PORT=3000
NODE_ENV=production
TRUST_PROXY=true
SESSION_SECRET=generate_a_random_32_byte_hex_secret_here
APP_BASE_URL=https://your-domain.com

# Database Configuration
# Leave DATABASE_URL empty to use local SQLite (data/invoicing.db).
# Provide a PostgreSQL connection string for production deployment (e.g. Supabase, Render, Neon, Fly.io Postgres).
DATABASE_URL=postgres://postgres:password@localhost:5432/invoicing_db

# Gmail / SMTP Email Configuration
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Paystack Payment Gateway API Credentials
# Obtain from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAID_PLAN_CODE=PLN_xxxxxxxxxxxx
