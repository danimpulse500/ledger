<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-900 font-sans antialiased">
  <div class="min-h-screen flex items-center justify-center bg-slate-900 p-4 py-8">
    <div class="bg-white border border-slate-800 rounded-2xl p-8 md:p-10 w-full max-w-xl shadow-2xl">
      <h1 class="text-2xl font-black text-center text-slate-900 mb-1 uppercase tracking-tight">Ledger</h1>
      <div class="text-center text-slate-500 text-sm mb-6">Create your workspace &bull; 14-day free trial</div>

      <% if (error) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= error %></div>
      <% } %>

      <form method="POST" action="/signup" class="space-y-4">
        <input type="hidden" name="plan" id="selectedPlanInput" value="<%= plan %>">

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-2">Choose Subscription Plan</label>
          <div class="grid grid-cols-3 gap-2.5 mb-2">
            <div class="plan-box border border-slate-200 bg-slate-50 rounded-xl p-2.5 text-center cursor-pointer transition-all hover:border-slate-900 <%= plan === 'starter' ? 'selected' : '' %>" onclick="selectPlan('starter', this)">
              <div class="font-bold text-xs text-slate-900">Starter</div>
              <div class="font-mono font-semibold text-lg text-slate-900 my-0.5">$15<span class="text-xs text-slate-500 font-sans">/mo</span></div>
              <div class="text-[0.72rem] text-slate-500">Solo & Freelance</div>
            </div>
            <div class="plan-box border border-slate-200 bg-slate-50 rounded-xl p-2.5 text-center cursor-pointer transition-all hover:border-slate-900 <%= plan === 'pro' ? 'selected' : '' %>" onclick="selectPlan('pro', this)">
              <div class="font-bold text-xs text-slate-900">Pro</div>
              <div class="font-mono font-semibold text-lg text-slate-900 my-0.5">$49<span class="text-xs text-slate-500 font-sans">/mo</span></div>
              <div class="text-[0.72rem] text-slate-500">Growing Teams</div>
            </div>
            <div class="plan-box border border-slate-200 bg-slate-50 rounded-xl p-2.5 text-center cursor-pointer transition-all hover:border-slate-900 <%= plan === 'enterprise' ? 'selected' : '' %>" onclick="selectPlan('enterprise', this)">
              <div class="font-bold text-xs text-slate-900">Enterprise</div>
              <div class="font-mono font-semibold text-lg text-slate-900 my-0.5">$199<span class="text-xs text-slate-500 font-sans">/mo</span></div>
              <div class="text-[0.72rem] text-slate-500">Unlimited Scale</div>
            </div>
          </div>
        </div>

        <div>
          <label for="company_name" class="block text-xs font-semibold text-slate-600 mb-1.5">Company / Business Name</label>
          <input type="text" id="company_name" name="company_name" value="<%= company_name %>" required placeholder="e.g. Apex Digital Ltd" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label for="name" class="block text-xs font-semibold text-slate-600 mb-1.5">Your Name</label>
            <input type="text" id="name" name="name" value="<%= name %>" required placeholder="Jane Doe" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex-1">
            <label for="email" class="block text-xs font-semibold text-slate-600 mb-1.5">Work Email</label>
            <input type="email" id="email" name="email" value="<%= email %>" required placeholder="jane@company.com" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-slate-600 mb-1.5">Password (min 8 characters)</label>
          <input type="password" id="password" name="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>

        <button type="submit" class="w-full inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-4 py-3 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0 mt-2">
          Start 14-Day Free Trial &rarr;
        </button>
      </form>

      <div class="text-center mt-5 text-sm text-slate-500">
        Already have a workspace? <a href="/login" class="text-slate-900 font-semibold no-underline hover:underline">Log in</a>
      </div>
    </div>
  </div>

  <script>
    function selectPlan(planName, el) {
      document.getElementById('selectedPlanInput').value = planName;
      document.querySelectorAll('.plan-box').forEach(box => box.classList.remove('selected'));
      el.classList.add('selected');
    }
  </script>
</body>
</html>
