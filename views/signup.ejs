<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="bg-white text-slate-900 font-sans antialiased">
  <div
    class="min-h-screen w-full flex flex-col lg:flex-row items-center justify-center p-6 lg:p-12 max-w-7xl mx-auto gap-8 lg:gap-12">

    <!-- Left Column: Signup Form -->
    <div class="w-full lg:w-1/2 max-w-lg px-2 sm:px-6 py-4 flex flex-col justify-center">

      <!-- Step Indicator Pills -->
      <div class="flex items-center gap-2 mb-6">
        <div class="w-7 h-1.5 rounded-full bg-slate-900"></div>
        <div class="w-7 h-1.5 rounded-full bg-slate-200"></div>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mb-2">Welcome</h1>
      <p class="text-slate-500 text-sm mb-8">Send invoices. Track payments. Skip the spreadsheet.</p>

      <% if (error) { %>
        <div class="p-3.5 rounded-xl text-sm mb-6 bg-red-50 text-red-600 border border-red-200 font-medium">
          <%= error %>
        </div>
        <% } %>

          <form method="POST" action="/signup" class="space-y-5">
            <input type="hidden" name="plan" id="selectedPlanInput" value="<%= plan %>">

            <div class="mb-2">
              <label for="company_name" class="block text-xs font-semibold text-slate-600 mb-1.5">Company Name</label>
              <input type="text" id="company_name" name="company_name" value="<%= company_name %>" required
                placeholder="e.g. Acme Ltd."
                class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
            </div>

            <div class="flex flex-col sm:flex-row gap-4 mb-2">
              <div class="flex-1">
                <label for="name" class="block text-xs font-semibold text-slate-600 mb-1.5">Your Name</label>
                <input type="text" id="name" name="name" value="<%= name %>" required placeholder="Start typing..."
                  class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors" placeholder="e.g. John Doe">
              </div>
            </div>

            <div class="mb-2">
              <label for="email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email address</label>
              <input type="email" id="email" name="email" value="<%= email %>" required placeholder="you@example.com"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
            </div>

            <div class="mb-2">
              <label for="password" class="block text-xs font-semibold text-slate-600 mb-1.5">Password</label>
              <input type="password" id="password" name="password" required placeholder="Choose a password"
                class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
            </div>

            <div class="pt-2">
              <button type="submit"
                class="inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-8 py-3 rounded-full cursor-pointer hover:opacity-90 transition-all border-0 shadow-sm">
                Continue
              </button>
            </div>
          </form>

          <div class="mt-8 text-sm text-slate-500">
            Already have a workspace? <a href="/login" class="text-slate-900 font-bold no-underline hover:underline">Log
              in</a>
          </div>
    </div>

    <!-- Right Column: Illustration Card -->
    <div class="w-full lg:w-1/2 flex items-center justify-center p-4">
      <div
        class="w-full h-full min-h-[420px] lg:min-h-[580px] bg-white border border-slate-200/80 rounded-3xl shadow-xs p-8 flex items-center justify-center relative overflow-hidden">
        <img src="/signup-bg.png" alt="Invoice Illustration" class="max-w-md w-full h-auto object-contain">
      </div>
    </div>

  </div>
</body>

</html>