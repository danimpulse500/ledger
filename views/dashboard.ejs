<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('partials/sidebar') %>
    
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">

      <!-- Top Navigation & Search Bar -->
      <div class="flex justify-between items-center mb-6 gap-4 flex-wrap">
        <div class="relative w-full max-w-sm">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="dashboard-search" placeholder="Search invoices, customers, products..." onkeyup="filterDashboardTables(this.value)" class="w-full pl-10 pr-4 py-2 rounded-full border border-slate-200 bg-white text-sm text-slate-900 focus:outline-none focus:border-slate-400">
        </div>

        <div class="flex items-center gap-3">
          <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white rounded-full px-5 py-2 text-sm font-semibold hover:bg-slate-800 transition-colors border-0 cursor-pointer" data-modal-target="<%= (typeof isBillingActive !== 'undefined' && isBillingActive) ? 'modal-invoice' : 'modal-paystack-billing' %>">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            New Invoice
          </button>
          
          <!-- Quick Add Dropdown -->
          <div class="relative inline-block" onclick="event.stopPropagation()">
            <button type="button" class="inline-flex items-center gap-1.5 bg-white text-slate-700 border border-slate-200 rounded-full px-4 py-2 text-sm font-semibold hover:bg-slate-50 transition-colors cursor-pointer" onclick="toggleActionDropdown(event, this)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Quick Add
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-0.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="action-dropdown-menu absolute right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 min-w-[160px] py-1">
              <button type="button" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 transition-colors bg-transparent border-0 cursor-pointer" onclick="closeAllDropdowns(); openModal('modal-client');">Customer</button>
              <button type="button" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 transition-colors bg-transparent border-0 cursor-pointer" onclick="closeAllDropdowns(); openModal('modal-product');">Product</button>
              <button type="button" class="w-full text-left px-4 py-2 text-sm text-slate-700 hover:bg-slate-100 transition-colors bg-transparent border-0 cursor-pointer" onclick="closeAllDropdowns(); openModal('modal-expense');">Expense</button>
            </div>
          </div>

          <!-- Dark Mode Toggle Button -->
          <button type="button" onclick="toggleDarkMode()" class="w-9 h-9 rounded-full border border-slate-200 bg-white text-slate-700 flex items-center justify-center cursor-pointer hover:bg-slate-100 transition-colors shadow-xs" title="Toggle dark mode" aria-label="Toggle dark mode">
            <!-- Sun icon (shown when in dark mode) -->
            <svg class="theme-icon-sun hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <!-- Moon icon (shown when in light mode) -->
            <svg class="theme-icon-moon block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- 4 Stat Cards Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Total Invoice -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.total_invoice_count || 0 %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Invoice</div>
        </div>

        <!-- Revenue -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= currencySymbol %><%= (Number(stats.revenue_this_month) || 0).toFixed(2) %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Revenue</div>
        </div>

        <!-- Pending Invoice -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= stats.sent_count || 0 %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Pending Invoice</div>
        </div>

        <!-- Overdue -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight <%= stats.overdue_count > 0 ? 'text-red-500' : 'text-slate-900' %>"><%= stats.overdue_count || 0 %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Overdue</div>
        </div>
      </div>

      <!-- Section: Draft Invoices -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs mb-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-slate-900 m-0">Draft</h3>
          <a href="/invoices?status=draft" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-700 hover:text-slate-900 no-underline">
            View drafts
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <% if (!draftInvoices || draftInvoices.length === 0) { %>
          <div class="flex flex-col items-center justify-center py-8 text-center gap-2">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center mb-1">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
              </svg>
            </div>
            <p class="text-slate-500 text-sm m-0">No draft invoices. <a href="#" data-modal-target="modal-invoice" class="text-slate-900 font-semibold underline">Create a new invoice</a>.</p>
          </div>
        <% } else { %>
          <table class="w-full border-collapse text-sm" id="table-drafts">
            <thead>
              <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                <th class="py-2.5 px-3 w-[50px]">No</th>
                <th class="py-2.5 px-3">Invoice</th>
                <th class="py-2.5 px-3">Customer</th>
                <th class="py-2.5 px-3">Issue Date</th>
                <th class="py-2.5 px-3">Status</th>
                <th class="py-2.5 px-3 text-right">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% draftInvoices.forEach((inv, index) => { %>
                <tr class="hover:bg-slate-50 cursor-pointer transition-colors" onclick="window.location='/invoices/<%= inv.id %>'">
                  <td class="py-3 px-3 text-slate-400 text-xs"><%= String(index + 1).padStart(2, '0') %></td>
                  <td class="py-3 px-3 font-semibold text-slate-900"><%= inv.invoice_number %></td>
                  <td class="py-3 px-3 text-slate-800"><%= inv.client_name %></td>
                  <td class="py-3 px-3 text-slate-500"><%= inv.issue_date %></td>
                  <td class="py-3 px-3">
                    <span class="status-pill status-<%= inv.status %>">
                      <%= inv.status %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-right font-semibold text-slate-900"><%= currencySymbol %><%= (Number(inv.total) || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- Section: Recent Invoices -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-bold text-slate-900 m-0">Recent Invoices</h3>
          <a href="/invoices" class="inline-flex items-center gap-1 text-sm font-semibold text-slate-700 hover:text-slate-900 no-underline">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <% if (recentInvoices.length === 0) { %>
          <div class="flex flex-col items-center justify-center py-8 text-center gap-2">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-500 flex items-center justify-center mb-1">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
              </svg>
            </div>
            <p class="text-slate-500 text-sm m-0">No invoices created yet. <a href="#" data-modal-target="modal-invoice" class="text-slate-900 font-semibold underline">Create your first invoice</a>.</p>
          </div>
        <% } else { %>
          <table class="w-full border-collapse text-sm" id="table-recent">
            <thead>
              <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                <th class="py-2.5 px-3 w-[50px]">No</th>
                <th class="py-2.5 px-3">Invoice</th>
                <th class="py-2.5 px-3">Customer</th>
                <th class="py-2.5 px-3">Issued Date</th>
                <th class="py-2.5 px-3">Status</th>
                <th class="py-2.5 px-3 text-right">Total Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% recentInvoices.forEach((inv, index) => { %>
                <tr class="hover:bg-slate-50 cursor-pointer transition-colors" onclick="window.location='/invoices/<%= inv.id %>'">
                  <td class="py-3 px-3 text-slate-400 text-xs"><%= String(index + 1).padStart(2, '0') %></td>
                  <td class="py-3 px-3 font-semibold text-slate-900"><%= inv.invoice_number %></td>
                  <td class="py-3 px-3 text-slate-800"><%= inv.client_name %></td>
                  <td class="py-3 px-3 text-slate-500"><%= inv.issue_date %></td>
                  <td class="py-3 px-3">
                    <span class="status-pill status-<%= inv.status %>">
                      <%= inv.status %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-right font-semibold text-slate-900"><%= currencySymbol %><%= (Number(inv.total) || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

    </div>
  </div>

  <script>
    function filterDashboardTables(query) {
      const q = query.toLowerCase().trim();
      const rows = document.querySelectorAll('table tbody tr');
      rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        r.style.display = text.includes(q) ? '' : 'none';
      });
    }

    function closeAllDropdowns() {
      document.querySelectorAll('.action-dropdown-menu.open').forEach(m => m.classList.remove('open'));
    }

    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const menu = btn.nextElementSibling;
      const isOpen = menu.classList.contains('open');
      closeAllDropdowns();
      if (!isOpen) menu.classList.add('open');
    }

    document.addEventListener('click', closeAllDropdowns);
  </script>
</body>
</html>
