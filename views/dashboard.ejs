<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar') %>
    
    <div class="main">

      <!-- Top Navigation & Search Bar -->
      <div class="topbar-invoxa">
        <div class="search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="dashboard-search" placeholder="Search invoices, clients, products..." onkeyup="filterDashboardTables(this.value)">
        </div>

        <div class="header-actions">
          <button type="button" class="btn btn-pill-primary" data-modal-target="modal-invoice">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            New Invoice
          </button>
          <!-- Quick Add Dropdown -->
          <div class="action-dropdown p-3 py-3 text-15" onclick="event.stopPropagation()">
            <button type="button" class="btn btn-pill-outline" onclick="toggleActionDropdown(event, this)">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Quick Add
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-left:2px;">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="action-dropdown-menu">
              <button type="button" class="dropdown-item" onclick="closeAllDropdowns(); openModal('modal-client');">
                <!-- <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;flex-shrink:0;">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="8.5" cy="7" r="4"></circle>
                  <line x1="20" y1="8" x2="20" y2="14"></line>
                  <line x1="17" y1="11" x2="23" y2="11"></line>
                </svg> -->
                 Client
              </button>
              <button type="button" class="dropdown-item" onclick="closeAllDropdowns(); openModal('modal-product');">
                <!-- <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;flex-shrink:0;">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg> -->
                 Product
              </button>
              <button type="button" class="dropdown-item" onclick="closeAllDropdowns(); openModal('modal-expense');">
                <!-- <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:8px;flex-shrink:0;">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg> -->
                 Expense
              </button>
            </div>
          </div>
          <!-- <button class="icon-btn-pill" title="Notifications">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <% if (stats.overdue_count > 0) { %><span class="notification-dot"></span><% } %>
          </button>
          <div class="user-chip">
            <div class="chip-avatar"><%= currentUser.name.split(' ').slice(0,2).map(n=>n[0]).join('').toUpperCase() %></div>
          </div> -->
        </div>
      </div>

      <!-- 4 Stat Cards Row -->
      <div class="grid grid-4 stat-grid">
        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <div class="stat-number figure"><%= stats.client_count || 0 %></div>
          </div>
          <div class="stat-bottom">Total Clients</div>
        </div>

        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
            </div>
            <div class="stat-number figure"><%= stats.active_count || 0 %></div>
          </div>
          <div class="stat-bottom">Active Invoices</div>
        </div>

        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="stat-number figure"><%= currencySymbol %><%= stats.revenue_this_month.toFixed(2) %></div>
          </div>
          <div class="stat-bottom">Revenue This Month</div>
        </div>

        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="stat-number figure <%= stats.overdue_count > 0 ? 'text-danger' : '' %>"><%= stats.overdue_count || 0 %></div>
          </div>
          <div class="stat-bottom">Pending Reviews</div>
        </div>
      </div>

      <!-- Section: Continue Working (Outstanding) -->
      <div class="card invoxa-section-card">
        <div class="section-title">
          <h3>Continue Working</h3>
          <a href="/invoices?status=overdue" class="section-link">
            View overdue
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <% if (outstanding.length === 0) { %>
          <div class="empty-notice">
            <div class="empty-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <p class="text-soft">No outstanding invoices requiring immediate action. Nice work!</p>
          </div>
        <% } else { %>
          <table class="invoxa-table" id="table-outstanding">
            <thead>
              <tr>
                <th style="width: 50px;">No</th>
                <th>Invoice</th>
                <th>Client</th>
                <th>Due Date</th>
                <th>Status</th>
                <th class="money">Balance</th>
              </tr>
            </thead>
            <tbody>
              <% outstanding.forEach((inv, index) => { %>
                <tr class="clickable-row" onclick="window.location='/invoices/<%= inv.id %>'">
                  <td class="num-col"><%= String(index + 1).padStart(2, '0') %></td>
                  <td><strong class="figure"><%= inv.invoice_number %></strong></td>
                  <td><%= inv.client_name %></td>
                  <td class="text-soft"><%= inv.due_date %></td>
                  <td>
                    <span class="status-pill status-<%= inv.status %>">
                      <%= inv.status %>
                    </span>
                  </td>
                  <td class="money"><%= currencySymbol %><%= (inv.total - inv.amount_paid).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- Section: Recent Invoices -->
      <div class="card invoxa-section-card" style="margin-top:20px;">
        <div class="section-title">
          <h3>Recent Invoices</h3>
          <a href="/invoices" class="section-link">
            View all
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <% if (recentInvoices.length === 0) { %>
          <div class="empty-notice">
            <div class="empty-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
              </svg>
            </div>
            <p class="text-soft">No invoices created yet. <a href="#" data-modal-target="modal-invoice">Create your first invoice</a>.</p>
          </div>
        <% } else { %>
          <table class="invoxa-table" id="table-recent">
            <thead>
              <tr>
                <th style="width: 50px;">No</th>
                <th>Invoice</th>
                <th>Client</th>
                <th>Issued Date</th>
                <th>Status</th>
                <th class="money">Total Amount</th>
              </tr>
            </thead>
            <tbody>
              <% recentInvoices.forEach((inv, index) => { %>
                <tr class="clickable-row" onclick="window.location='/invoices/<%= inv.id %>'">
                  <td class="num-col"><%= String(index + 1).padStart(2, '0') %></td>
                  <td><strong class="figure"><%= inv.invoice_number %></strong></td>
                  <td><%= inv.client_name %></td>
                  <td class="text-soft"><%= inv.issue_date %></td>
                  <td>
                    <span class="status-pill status-<%= inv.status %>">
                      <%= inv.status %>
                    </span>
                  </td>
                  <td class="money"><%= currencySymbol %><%= inv.total.toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

    </div>
  </div>

  <script>
    function filterDashboardTables(query) {
      const q = query.toLowerCase().trim();
      const rows = document.querySelectorAll('.invoxa-table tbody tr');
      rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        r.style.display = text.includes(q) ? '' : 'none';
      });
    }

    function closeAllDropdowns() {
      document.querySelectorAll('.action-dropdown-menu.open').forEach(m => m.classList.remove('open'));
    }

    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const menu = btn.nextElementSibling;
      const isOpen = menu.classList.contains('open');
      closeAllDropdowns();
      if (!isOpen) menu.classList.add('open');
    }

    document.addEventListener('click', closeAllDropdowns);
  </script>
</body>
</html>
