      <!-- STEP 2: Functional Billing & Card Details Form (Initially Hidden) -->
      <div id="paystack-step-form" class="hidden w-full py-2">
        <button type="button" onclick="showPaystackOverview()" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 bg-transparent border-0 cursor-pointer p-0 mb-4 transition-colors">
