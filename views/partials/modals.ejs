              </div>
              <input type="text" id="paystack-card-num" placeholder="4532 •••• •••• 8892" maxlength="19" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-mono bg-slate-50/50 text-slate-900 focus:outline-none focus:bg-white focus:border-slate-900 transition-all">
