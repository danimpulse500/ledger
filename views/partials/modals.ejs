            <button type="submit" id="paystack-submit-btn" class="w-full h-12 inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider px-5 rounded-xl cursor-pointer transition-all border-0 shadow-md mt-2">
              <span>Pay</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
<!-- Paystack Pop & Trial Activation Script -->
<script>
  let selectedPlanCycle = 'monthly';

  function selectPlanCycle(cycle) {
    selectedPlanCycle = cycle;
    const btnMonthly = document.getElementById('toggle-monthly-btn');
    const btnYearly = document.getElementById('toggle-yearly-btn');
    const priceDisplay = document.getElementById('plan-price-display');

    if (cycle === 'yearly') {
      if (btnMonthly) {
        btnMonthly.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer bg-transparent';
      }
      if (btnYearly) {
        btnYearly.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer flex items-center justify-center gap-1.5';
      }
      if (priceDisplay) {
        priceDisplay.innerHTML = `<p class="text-3xl font-black text-slate-900 m-0"><%= currencySymbol %>44,000 <span class="text-xs font-medium text-slate-500">/ Year</span> <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full ml-1">(Save 20% / <%= currencySymbol %>11,000)</span></p>`;
      }
    } else {
      if (btnYearly) {
        btnYearly.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer bg-transparent flex items-center justify-center gap-1.5';
      }
      if (btnMonthly) {
        btnMonthly.className = 'flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer';
      }
      if (priceDisplay) {
        priceDisplay.innerHTML = `<p class="text-3xl font-black text-slate-900 m-0"><%= currencySymbol %>5,500 <span class="text-xs font-medium text-slate-500">/ Month</span></p>`;
      }
    }
  }

  function triggerPaystackBillingModal() {
    showPaystackOverview();
    openModal('modal-paystack-billing');
  }

  function showPaystackBillingForm() {
    const card = document.getElementById('paystack-modal-card');
    const step1 = document.getElementById('paystack-step-overview');
    const step2 = document.getElementById('paystack-step-form');
    if (card) {
      card.classList.remove('max-w-4xl');
      card.classList.add('max-w-md');
    }
    if (step1 && step2) {
      step1.classList.add('hidden');
      step2.classList.remove('hidden');
    }
  }

  function showPaystackOverview() {
    const card = document.getElementById('paystack-modal-card');
    const step1 = document.getElementById('paystack-step-overview');
    const step2 = document.getElementById('paystack-step-form');
    if (card) {
      card.classList.remove('max-w-md');
      card.classList.add('max-w-4xl');
    }
    if (step1 && step2) {
      step2.classList.add('hidden');
      step1.classList.remove('hidden');
    }
  }

  async function handlePaystackCheckout(e) {
    e.preventDefault();
    const btn = document.getElementById('paystack-submit-btn');
    const email = document.getElementById('paystack-email').value;
    const cardNum = document.getElementById('paystack-card-num').value.replace(/\s+/g, '');
    const expVal = document.getElementById('paystack-card-exp').value;
    const cvv = document.getElementById('paystack-card-cvv').value;

    btn.disabled = true;
    btn.innerHTML = '<span>Processing Secure Verification...</span>';

    const expParts = expVal.split('/');
    const expMonth = expParts[0] ? expParts[0].trim() : '12';
    const expYear = expParts[1] ? expParts[1].trim() : '28';
    const last4 = cardNum.length >= 4 ? cardNum.slice(-4) : '4242';

    try {
      const res = await fetch('/billing/trial/activate', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          email: email,
          plan: selectedPlanCycle === 'yearly' ? 'pro_yearly' : 'starter',
          card_brand: cardNum.startsWith('4') ? 'Visa' : 'MasterCard',
          card_last4: last4,
          card_exp_month: expMonth,
          card_exp_year: expYear,
          paystack_auth_code: 'AUTH_' + Math.random().toString(36).substring(2, 10).toUpperCase()
        })
      });

      const data = await res.json();
      if (data.status) {
        window.location.href = data.redirectUrl || '/invoices/new';
      } else {
        alert(data.message || 'Failed to activate trial. Please try again.');
        btn.disabled = false;
        btn.innerHTML = '<span>Start 30-Day Free Trial</span>';
      }
    } catch (err) {
      console.error('Paystack Trial Error:', err);
      alert('An error occurred. Please try again.');
      btn.disabled = false;
      btn.innerHTML = '<span>Start 30-Day Free Trial</span>';
    }
  }

  // Auto-open modal if URL query has ?billingModal=1
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('billingModal') === '1') {
      triggerPaystackBillingModal();
    }
  });
</script>

<!-- Hidden product selector options template -->
<select id="mi-products-template" class="hidden">
  <option value="" data-name="" data-desc="" data-price="0.00" data-tax="<%= defaultDiscountRate || 0 %>">Custom Item...
  </option>
  <% if (typeof globalProducts !=='undefined' && globalProducts.length) { %>
    <% globalProducts.forEach(p=> { %>
      <option value="<%= p.id %>" data-name="<%= p.name %>" data-desc="<%= p.description %>"
        data-price="<%= p.unit_price.toFixed(2) %>" data-tax="<%= p.tax_rate %>">
        <%= p.name %>
      </option>
      <% }) %>
        <% } %>
</select>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const miBody = document.getElementById('mi-items-body');
    const miBtn = document.getElementById('mi-add-item');
    const miTotalDisp = document.getElementById('mi-disp-total');

    function addModalInvoiceRow() {
      if (!miBody) return;
      const idx = miBody.children.length;
      const tr = document.createElement('tr');
      tr.className = 'item-row border-b border-slate-100';
      const productsHtml = document.getElementById('mi-products-template').innerHTML;
      tr.innerHTML = `
      <td class="py-2 px-2.5">
        <select name="items[${idx}][product_id]" class="mi-product-select w-full py-1.5 px-2 text-xs border border-slate-200 rounded-md">
          ${productsHtml}
        </select>
        <input type="hidden" name="items[${idx}][description]" class="mi-product-name">
        <input type="hidden" name="items[${idx}][tax_rate]" class="mi-product-tax" value="0">
      </td>
      <td class="py-2 px-2.5">
        <span class="mi-details-text text-xs text-slate-500">—</span>
        <input type="hidden" name="items[${idx}][details]" class="mi-details">
      </td>
      <td class="py-2 px-2.5">
        <input type="number" name="items[${idx}][quantity]" value="1" min="1" step="1" class="mi-qty w-14 py-1 px-1.5 text-xs border border-slate-200 rounded-md">
      </td>
      <td class="py-2 px-2.5">
        <span class="mi-price-text text-xs text-slate-700 font-mono"><%= currencySymbol %>0.00</span>
        <input type="hidden" name="items[${idx}][unit_price]" value="0.00" class="mi-price">
      </td>
      <td class="py-2 px-2.5 font-mono text-xs font-semibold text-slate-900 mi-line-total"><%= currencySymbol %>0.00</td>
      <td class="py-2 px-2.5 text-right">
        <button type="button" class="mi-del-row bg-transparent border-0 text-slate-400 cursor-pointer font-bold text-lg hover:text-red-500 p-0 line-height-none">&minus;</button>
      </td>
    `;
      miBody.appendChild(tr);

      const select = tr.querySelector('.mi-product-select');
      const nameInput = tr.querySelector('.mi-product-name');
      const taxInput = tr.querySelector('.mi-product-tax');
      const descInput = tr.querySelector('.mi-details');
      const descText = tr.querySelector('.mi-details-text');
      const qtyInput = tr.querySelector('.mi-qty');
      const priceInput = tr.querySelector('.mi-price');
      const priceText = tr.querySelector('.mi-price-text');

      select.addEventListener('change', () => {
        const opt = select.options[select.selectedIndex];
        if (select.value === "") {
          nameInput.value = "Custom Item";
          descInput.value = "";
          descText.textContent = "—";
          qtyInput.value = "1";
          priceInput.value = "0.00";
          priceText.textContent = "<%= currencySymbol %>0.00";
          taxInput.value = "<%= defaultDiscountRate || 0 %>";
        } else {
          const name = opt.getAttribute('data-name') || "";
          const desc = opt.getAttribute('data-desc') || "";
          const price = opt.getAttribute('data-price') || "0.00";
          const tax = opt.getAttribute('data-tax') || "0";

          nameInput.value = name;
          descInput.value = desc;
          descText.textContent = desc || "—";
          qtyInput.value = "1";
          priceInput.value = price;
          priceText.textContent = "<%= currencySymbol %>" + parseFloat(price).toFixed(2);
          taxInput.value = tax;
        }
        calcModalInvoiceTotals();
      });

      select.dispatchEvent(new Event('change'));
    }

    function calcModalInvoiceTotals() {
      if (!miBody) return;
      let grand = 0;
      miBody.querySelectorAll('tr').forEach(tr => {
        const q = parseFloat(tr.querySelector('.mi-qty')?.value) || 0;
        const p = parseFloat(tr.querySelector('.mi-price')?.value) || 0;
        const discount = parseFloat(tr.querySelector('.mi-product-tax')?.value) || 0;
        const tot = q * p * (1 - discount / 100);
        grand += tot;
        const totEl = tr.querySelector('.mi-line-total');
        if (totEl) totEl.textContent = '<%= currencySymbol %>' + tot.toFixed(2);
      });
      if (miTotalDisp) miTotalDisp.textContent = '<%= currencySymbol %>' + grand.toFixed(2);
    }

    if (miBtn) {
      miBtn.addEventListener('click', addModalInvoiceRow);
      addModalInvoiceRow(); // Add default initial row
    }

    if (miBody) {
      miBody.addEventListener('input', calcModalInvoiceTotals);
      miBody.addEventListener('click', (e) => {
        if (e.target.classList.contains('mi-del-row')) {
          if (miBody.children.length > 1) {
            e.target.closest('tr').remove();
            calcModalInvoiceTotals();
          }
        }
      });
    }
  });
</script>