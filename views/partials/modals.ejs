                <input type="text" id="paystack-card-exp" placeholder="MM / YY" maxlength="5" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-mono bg-slate-50/50 text-slate-900 focus:outline-none focus:bg-white focus:border-slate-900 transition-all">
