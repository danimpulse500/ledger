<!-- Modal: New Client -->
<div class="modal-overlay" id="modal-client">
  <div class="modal-container">
    <div class="modal-header">
      <h3>New Client</h3>
      <button type="button" class="modal-close" onclick="closeModal('modal-client')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/clients">
      <div class="modal-body">
        <div class="field">
          <label for="mc-name">Client Name *</label>
          <input type="text" id="mc-name" name="name" placeholder="Acme Corp or John Doe" required>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="mc-email">Email</label>
            <input type="email" id="mc-email" name="email" placeholder="billing@acme.com">
          </div>
          <div class="field">
            <label for="mc-phone">Phone</label>
            <input type="tel" id="mc-phone" name="phone" placeholder="+1 (555) 000-0000">
          </div>
        </div>
        <div class="field">
          <label for="mc-address">Address</label>
          <textarea id="mc-address" name="address" rows="2" placeholder="Street, City, State, ZIP"></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="mc-tax_id">Tax / VAT ID</label>
            <input type="text" id="mc-tax_id" name="tax_id" placeholder="US123456789">
          </div>
        </div>
        <div class="field">
          <label for="mc-notes">Notes</label>
          <textarea id="mc-notes" name="notes" rows="2" placeholder="Payment preferences, contacts..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('modal-client')">Cancel</button>
        <button type="submit" class="btn">Save Client</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Product/Service -->
<div class="modal-overlay" id="modal-product">
  <div class="modal-container">
    <div class="modal-header">
      <h3>New Product or Service</h3>
      <button type="button" class="modal-close" onclick="closeModal('modal-product')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/products">
      <div class="modal-body">
        <div class="field">
          <label for="mp-name">Name *</label>
          <input type="text" id="mp-name" name="name" placeholder="Web Design, Consulting, Widget A" required>
        </div>
        <div class="field">
          <label for="mp-description">Description</label>
          <textarea id="mp-description" name="description" rows="2" placeholder="Detailed service description..."></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="mp-unit_price">Unit Price ($) *</label>
            <input type="number" step="0.01" min="0" id="mp-unit_price" name="unit_price" placeholder="0.00" required>
          </div>
          <div class="field">
            <label for="mp-tax_rate">Discount (%)</label>
            <input type="number" step="0.01" min="0" id="mp-tax_rate" name="tax_rate" value="0" placeholder="0.00">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('modal-product')">Cancel</button>
        <button type="submit" class="btn">Save Product</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Expense -->
<div class="modal-overlay" id="modal-expense">
  <div class="modal-container">
    <div class="modal-header">
      <h3>New Expense</h3>
      <button type="button" class="modal-close" onclick="closeModal('modal-expense')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/expenses">
      <div class="modal-body">
        <div class="field">
          <label for="me-description">Description *</label>
          <input type="text" id="me-description" name="description" placeholder="Domain Renewal, Office Supplies" required>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="me-amount">Amount ($) *</label>
            <input type="number" step="0.01" min="0.01" id="me-amount" name="amount" placeholder="0.00" required>
          </div>
          <div class="field">
            <label for="me-expense_date">Date *</label>
            <input type="date" id="me-expense_date" name="expense_date" value="<%= new Date().toISOString().slice(0, 10) %>" required>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="me-category">Category</label>
            <input type="text" id="me-category" name="category" value="General" list="modal-cat-list">
            <datalist id="modal-cat-list">
              <option value="General"><option value="Software"><option value="Travel">
              <option value="Office Supplies"><option value="Marketing"><option value="Utilities">
            </datalist>
          </div>
          <div class="field">
            <label for="me-vendor">Vendor</label>
            <input type="text" id="me-vendor" name="vendor" placeholder="AWS, Staples, Google">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('modal-expense')">Cancel</button>
        <button type="submit" class="btn">Save Expense</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Invoice -->
<div class="modal-overlay" id="modal-invoice">
  <div class="modal-container modal-lg">
    <div class="modal-header">
      <h3>Create New Invoice</h3>
      <button type="button" class="modal-close" onclick="closeModal('modal-invoice')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/invoices" id="modal-invoice-form">
      <div class="modal-body">
        <div class="field-row">
          <div class="field">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
              <label for="mi-client" style="margin:0;">Client *</label>
              <button type="button" class="btn btn-outline btn-sm" data-modal-target="modal-client" style="padding:2px 8px; font-size:0.75rem;">+ Add New Client</button>
            </div>
            <select id="mi-client" name="client_id" required>
              <option value="">Select a client...</option>
              <% if (typeof globalClients !== 'undefined' && globalClients.length) { %>
                <% globalClients.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="field">
            <label for="mi-status">Status</label>
            <select id="mi-status" name="status">
              <option value="draft">Draft</option>
              <option value="sent">Sent</option>
              <option value="paid">Paid</option>
            </select>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="mi-issue_date">Issue Date *</label>
            <input type="date" id="mi-issue_date" name="issue_date" value="<%= new Date().toISOString().slice(0, 10) %>" required>
          </div>
          <div class="field">
            <label for="mi-due_date">Due Date *</label>
            <input type="date" id="mi-due_date" name="due_date" value="<%= new Date(Date.now() + 14*24*60*60*1000).toISOString().slice(0, 10) %>" required>
          </div>
        </div>

        <!-- Line Items -->
        <div style="margin-top:16px;">
          <div class="section-title" style="margin-bottom:10px;">
            <h4 style="margin:0; font-size:0.95rem;">Line Items</h4>
            <div style="display:flex; gap:8px;">
              <button type="button" class="btn btn-outline btn-sm" data-modal-target="modal-product">+ New Product</button>
              <button type="button" class="btn btn-outline btn-sm" id="mi-add-item">+ Add Line</button>
            </div>
          </div>
          <table class="invoxa-table" style="width:100%;">
            <thead>
              <tr>
                <th style="width:30%;">Item</th>
                <th>Description</th>
                <th style="width:70px;">Qty</th>
                <th style="width:100px;">Price</th>
                <th style="width:90px;" class="money">Total</th>
                <th style="width:30px;"></th>
              </tr>
            </thead>
            <tbody id="mi-items-body"></tbody>
          </table>
          <div class="totals" style="text-align:right; margin-top:12px; font-weight:700; font-size:1.05rem;">
            Total: <span id="mi-disp-total" class="figure"><%= currencySymbol %>0.00</span>
          </div>
        </div>

        <div class="field" style="margin-top:16px;">
          <label for="mi-notes">Notes</label>
          <textarea id="mi-notes" name="notes" rows="2" placeholder="Payment instructions, notes..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('modal-invoice')">Cancel</button>
        <button type="submit" class="btn">Create Invoice</button>
      </div>
    </form>
  </div>
</div>

<!-- Hidden product selector options template -->
<select id="mi-products-template" style="display:none;">
  <option value="" data-name="" data-desc="" data-price="0.00" data-tax="<%= defaultDiscountRate || 0 %>">Custom Item...</option>
  <% if (typeof globalProducts !== 'undefined' && globalProducts.length) { %>
    <% globalProducts.forEach(p => { %>
      <option value="<%= p.id %>" data-name="<%= p.name %>" data-desc="<%= p.description %>" data-price="<%= p.unit_price.toFixed(2) %>" data-tax="<%= p.tax_rate %>"><%= p.name %></option>
    <% }) %>
  <% } %>
</select>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const miBody = document.getElementById('mi-items-body');
  const miBtn = document.getElementById('mi-add-item');
  const miTotalDisp = document.getElementById('mi-disp-total');

  function addModalInvoiceRow() {
    if (!miBody) return;
    const idx = miBody.children.length;
    const tr = document.createElement('tr');
    tr.className = 'item-row';
    const productsHtml = document.getElementById('mi-products-template').innerHTML;
    tr.innerHTML = `
      <td>
        <select name="items[${idx}][product_id]" class="mi-product-select" style="padding:6px 8px; width:100%;">
          ${productsHtml}
        </select>
        <input type="hidden" name="items[${idx}][description]" class="mi-product-name">
        <input type="hidden" name="items[${idx}][tax_rate]" class="mi-product-tax" value="0">
      </td>
      <td>
        <span class="mi-details-text">—</span>
        <input type="hidden" name="items[${idx}][details]" class="mi-details">
      </td>
      <td>
        <input type="number" name="items[${idx}][quantity]" value="1" min="1" step="1" class="mi-qty" style="padding:4px 6px; width:60px;">
      </td>
      <td>
        <span class="mi-price-text"><%= currencySymbol %>0.00</span>
        <input type="hidden" name="items[${idx}][unit_price]" value="0.00" class="mi-price">
      </td>
      <td class="money mi-line-total"><%= currencySymbol %>0.00</td>
      <td>
        <button type="button" class="mi-del-row" style="background:none; border:none; color:#64748b; cursor:pointer; font-weight:bold; font-size:1.25rem;">&minus;</button>
      </td>
    `;
    miBody.appendChild(tr);

    const select = tr.querySelector('.mi-product-select');
    const nameInput = tr.querySelector('.mi-product-name');
    const taxInput = tr.querySelector('.mi-product-tax');
    const descInput = tr.querySelector('.mi-details');
    const descText = tr.querySelector('.mi-details-text');
    const qtyInput = tr.querySelector('.mi-qty');
    const priceInput = tr.querySelector('.mi-price');
    const priceText = tr.querySelector('.mi-price-text');

    select.addEventListener('change', () => {
      const opt = select.options[select.selectedIndex];
      if (select.value === "") {
        nameInput.value = "Custom Item";
        descInput.value = "";
        descText.textContent = "—";
        qtyInput.value = "1";
        priceInput.value = "0.00";
        priceText.textContent = "<%= currencySymbol %>0.00";
        taxInput.value = "<%= defaultDiscountRate || 0 %>";
      } else {
        const name = opt.getAttribute('data-name') || "";
        const desc = opt.getAttribute('data-desc') || "";
        const price = opt.getAttribute('data-price') || "0.00";
        const tax = opt.getAttribute('data-tax') || "0";

        nameInput.value = name;
        descInput.value = desc;
        descText.textContent = desc || "—";
        qtyInput.value = "1";
        priceInput.value = price;
        priceText.textContent = "<%= currencySymbol %>" + parseFloat(price).toFixed(2);
        taxInput.value = tax;
      }
      calcModalInvoiceTotals();
    });

    select.dispatchEvent(new Event('change'));
  }

  function calcModalInvoiceTotals() {
    if (!miBody) return;
    let grand = 0;
    miBody.querySelectorAll('tr').forEach(tr => {
      const q = parseFloat(tr.querySelector('.mi-qty')?.value) || 0;
      const p = parseFloat(tr.querySelector('.mi-price')?.value) || 0;
      const discount = parseFloat(tr.querySelector('.mi-product-tax')?.value) || 0;
      const tot = q * p * (1 - discount / 100);
      grand += tot;
      const totEl = tr.querySelector('.mi-line-total');
      if (totEl) totEl.textContent = '<%= currencySymbol %>' + tot.toFixed(2);
    });
    if (miTotalDisp) miTotalDisp.textContent = '<%= currencySymbol %>' + grand.toFixed(2);
  }

  if (miBtn) {
    miBtn.addEventListener('click', addModalInvoiceRow);
    addModalInvoiceRow(); // Add default initial row
  }

  if (miBody) {
    miBody.addEventListener('input', calcModalInvoiceTotals);
    miBody.addEventListener('click', (e) => {
      if (e.target.classList.contains('mi-del-row')) {
        if (miBody.children.length > 1) {
          e.target.closest('tr').remove();
          calcModalInvoiceTotals();
        }
      }
    });
  }
});
</script>

