<!-- Modal: New Client -->
<div class="modal-overlay fixed inset-0 bg-slate-900/45 backdrop-blur-xs z-[1000] items-center justify-center p-4"
  id="modal-client">
  <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900 m-0">New Client</h3>
      <button type="button"
        class="bg-transparent border-0 text-slate-400 cursor-pointer p-1 rounded-md hover:text-slate-900 transition-colors"
        onclick="closeModal('modal-client')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/clients">
      <div class="space-y-4">
        <div>
          <label for="mc-name" class="block text-xs font-semibold text-slate-600 mb-1">Client Name *</label>
          <input type="text" id="mc-name" name="name" placeholder="Acme Corp or John Doe" required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <label for="mc-email" class="block text-xs font-semibold text-slate-600 mb-1">Email</label>
            <input type="email" id="mc-email" name="email" placeholder="billing@acme.com"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex-1">
            <label for="mc-phone" class="block text-xs font-semibold text-slate-600 mb-1">Phone</label>
            <input type="tel" id="mc-phone" name="phone" placeholder="+1 (555) 000-0000"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>
        <div>
          <label for="mc-address" class="block text-xs font-semibold text-slate-600 mb-1">Address</label>
          <textarea id="mc-address" name="address" rows="2" placeholder="Street, City, State, ZIP"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y min-h-[60px]"></textarea>
        </div>
        <div>
          <label for="mc-tax_id" class="block text-xs font-semibold text-slate-600 mb-1">Tax / VAT ID</label>
          <input type="text" id="mc-tax_id" name="tax_id" placeholder="US123456789"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div>
          <label for="mc-notes" class="block text-xs font-semibold text-slate-600 mb-1">Notes</label>
          <textarea id="mc-notes" name="notes" rows="2" placeholder="Payment preferences, contacts..."
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y min-h-[60px]"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-2.5 mt-6 pt-3 border-t border-slate-100">
        <button type="button"
          class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-100 hover:text-slate-900 transition-all"
          onclick="closeModal('modal-client')">Cancel</button>
        <button type="submit"
          class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-800 transition-all border-0">Save
          Client</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Product/Service -->
<div class="modal-overlay fixed inset-0 bg-slate-900/45 backdrop-blur-xs z-[1000] items-center justify-center p-4"
  id="modal-product">
  <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900 m-0">New Product or Service</h3>
      <button type="button"
        class="bg-transparent border-0 text-slate-400 cursor-pointer p-1 rounded-md hover:text-slate-900 transition-colors"
        onclick="closeModal('modal-product')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/products">
      <div class="space-y-4">
        <div>
          <label for="mp-name" class="block text-xs font-semibold text-slate-600 mb-1">Name *</label>
          <input type="text" id="mp-name" name="name" placeholder="Web Design, Consulting, Widget A" required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div>
          <label for="mp-description" class="block text-xs font-semibold text-slate-600 mb-1">Description</label>
          <textarea id="mp-description" name="description" rows="2" placeholder="Detailed service description..."
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y min-h-[60px]"></textarea>
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <label for="mp-unit_price" class="block text-xs font-semibold text-slate-600 mb-1">Unit Price ($) *</label>
            <input type="number" step="0.01" min="0" id="mp-unit_price" name="unit_price" placeholder="0.00" required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex-1">
            <label for="mp-tax_rate" class="block text-xs font-semibold text-slate-600 mb-1">Discount (%)</label>
            <input type="number" step="0.01" min="0" id="mp-tax_rate" name="tax_rate" value="0" placeholder="0.00"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>
      </div>
      <div class="flex justify-end gap-2.5 mt-6 pt-3 border-t border-slate-100">
        <button type="button"
          class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-100 hover:text-slate-900 transition-all"
          onclick="closeModal('modal-product')">Cancel</button>
        <button type="submit"
          class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-800 transition-all border-0">Save
          Product</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Expense -->
<div class="modal-overlay fixed inset-0 bg-slate-900/45 backdrop-blur-xs z-[1000] items-center justify-center p-4"
  id="modal-expense">
  <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900 m-0">New Expense</h3>
      <button type="button"
        class="bg-transparent border-0 text-slate-400 cursor-pointer p-1 rounded-md hover:text-slate-900 transition-colors"
        onclick="closeModal('modal-expense')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/expenses">
      <div class="space-y-4">
        <div>
          <label for="me-description" class="block text-xs font-semibold text-slate-600 mb-1">Description *</label>
          <input type="text" id="me-description" name="description" placeholder="Domain Renewal, Office Supplies"
            required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <label for="me-amount" class="block text-xs font-semibold text-slate-600 mb-1">Amount ($) *</label>
            <input type="number" step="0.01" min="0.01" id="me-amount" name="amount" placeholder="0.00" required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex-1">
            <label for="me-expense_date" class="block text-xs font-semibold text-slate-600 mb-1">Date *</label>
            <input type="date" id="me-expense_date" name="expense_date"
              value="<%= new Date().toISOString().slice(0, 10) %>" required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>
        <div class="flex gap-3">
          <div class="flex-1">
            <label for="me-category" class="block text-xs font-semibold text-slate-600 mb-1">Category</label>
            <input type="text" id="me-category" name="category" value="General" list="modal-cat-list"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            <datalist id="modal-cat-list">
              <option value="General">
              <option value="Software">
              <option value="Travel">
              <option value="Office Supplies">
              <option value="Marketing">
              <option value="Utilities">
            </datalist>
          </div>
          <div class="flex-1">
            <label for="me-vendor" class="block text-xs font-semibold text-slate-600 mb-1">Vendor</label>
            <input type="text" id="me-vendor" name="vendor" placeholder="AWS, Staples, Google"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>
      </div>
      <div class="flex justify-end gap-2.5 mt-6 pt-3 border-t border-slate-100">
        <button type="button"
          class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-100 hover:text-slate-900 transition-all"
          onclick="closeModal('modal-expense')">Cancel</button>
        <button type="submit"
          class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-800 transition-all border-0">Save
          Expense</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: New Invoice -->
<div class="modal-overlay fixed inset-0 bg-slate-900/45 backdrop-blur-xs z-[1000] items-center justify-center p-4"
  id="modal-invoice">
  <div
    class="bg-white rounded-2xl w-full max-w-2xl p-6 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900 m-0">Create New Invoice</h3>
      <button type="button"
        class="bg-transparent border-0 text-slate-400 cursor-pointer p-1 rounded-md hover:text-slate-900 transition-colors"
        onclick="closeModal('modal-invoice')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <form method="POST" action="/invoices" id="modal-invoice-form">
      <div class="space-y-4">
        <div class="flex gap-3">
          <div class="flex-1">
            <div class="flex justify-between items-center mb-1">
              <label for="mi-client" class="block text-xs font-semibold text-slate-600 m-0">Client *</label>
              <button type="button"
                class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-2 py-0.5 text-[0.75rem] font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all"
                data-modal-target="modal-client">+ Add New Client</button>
            </div>
            <select id="mi-client" name="client_id" required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              <option value="">Select a client...</option>
              <% if (typeof globalClients !=='undefined' && globalClients.length) { %>
                <% globalClients.forEach(c=> { %>
                  <option value="<%= c.id %>">
                    <%= c.name %>
                  </option>
                  <% }) %>
                    <% } %>
            </select>
          </div>
          <div class="flex-1">
            <label for="mi-status" class="block text-xs font-semibold text-slate-600 mb-1">Status</label>
            <select id="mi-status" name="status"
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              <option value="draft">Draft</option>
              <option value="sent">Sent</option>
              <option value="paid">Paid</option>
            </select>
          </div>
        </div>

        <div class="flex gap-3">
          <div class="flex-1">
            <label for="mi-issue_date" class="block text-xs font-semibold text-slate-600 mb-1">Issue Date *</label>
            <input type="date" id="mi-issue_date" name="issue_date" value="<%= new Date().toISOString().slice(0, 10) %>"
              required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex-1">
            <label for="mi-due_date" class="block text-xs font-semibold text-slate-600 mb-1">Due Date *</label>
            <input type="date" id="mi-due_date" name="due_date"
              value="<%= new Date(Date.now() + 14*24*60*60*1000).toISOString().slice(0, 10) %>" required
              class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
        </div>

        <!-- Line Items -->
        <div class="mt-4">
          <div class="flex justify-between items-center mb-2">
            <h4 class="m-0 text-sm font-bold text-slate-900">Line Items</h4>
            <div class="flex gap-2">
              <button type="button"
                class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-3 py-1 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all"
                data-modal-target="modal-product">+ New Product</button>
              <button type="button"
                class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-3 py-1 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all"
                id="mi-add-item">+ Add Line</button>
            </div>
          </div>
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase text-slate-500 font-semibold">
                <th class="py-2 px-2.5 w-[30%]">Item</th>
                <th class="py-2 px-2.5">Description</th>
                <th class="py-2 px-2.5 w-[70px]">Qty</th>
                <th class="py-2 px-2.5 w-[100px]">Price</th>
                <th class="py-2 px-2.5 w-[90px] font-mono">Total</th>
                <th class="py-2 px-2.5 w-[30px]"></th>
              </tr>
            </thead>
            <tbody id="mi-items-body" class="divide-y divide-slate-100"></tbody>
          </table>
          <div class="text-right mt-3 font-bold text-base text-slate-900">
            Total: <span id="mi-disp-total" class="font-mono tracking-tight">
              <%= currencySymbol %>0.00
            </span>
          </div>
        </div>

        <div class="mt-4">
          <label for="mi-notes" class="block text-xs font-semibold text-slate-600 mb-1">Notes</label>
          <textarea id="mi-notes" name="notes" rows="2" placeholder="Payment instructions, notes..."
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y min-h-[60px]"></textarea>
        </div>
      </div>
      <div class="flex justify-end gap-2.5 mt-6 pt-3 border-t border-slate-100">
        <button type="button"
          class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-100 hover:text-slate-900 transition-all"
          onclick="closeModal('modal-invoice')">Cancel</button>
        <button type="submit"
          class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-4 h-9.5 rounded-full cursor-pointer hover:bg-slate-800 transition-all border-0">Create
          Invoice</button>
      </div>
    </form>
  </div>
</div>
<!-- Paystack Pop SDK -->
<script src="https://js.paystack.co/v1/inline.js"></script>

<!-- Modal: Paystack Card & 30-Day Free Trial Billing Gateway -->
<div
  class="modal-overlay fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[1000] flex items-center justify-center p-4 sm:p-6"
  id="modal-paystack-billing">
  <div
    class="bg-white rounded-3xl w-full max-w-4xl shadow-2xl border border-slate-100 max-h-[92vh] overflow-hidden flex flex-col relative transition-all duration-300"
    id="paystack-modal-card">

    <div class="p-6 sm:p-8 modal-scrollable overflow-y-auto flex-1">
      
      <!-- Modal Top Header -->
      <div class="flex justify-between items-center pb-4 mb-6 border-b border-slate-100">
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900 m-0 tracking-tight">Ledger Pro</h2>
          <span class="bg-slate-900 text-white text-[0.68rem] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full">30 Days Free</span>
        </div>
        <button type="button"
          class="bg-transparent border-0 text-slate-400 cursor-pointer p-2 rounded-full hover:bg-slate-100 hover:text-slate-900 transition-colors"
          onclick="closeModal('modal-paystack-billing')" aria-label="Close modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- STEP 1: Plan Overview & Timeline -->
      <div id="paystack-step-overview" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Choose Plan & Duration -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <h2 class="text-2xl font-bold text-slate-900 m-0 tracking-tight">Choose plan</h2>
            <p class="text-xs text-slate-500 mt-1">Select a plan to start your 30-day risk-free trial.</p>
          </div>

          <!-- Plan Type Toggle Pills -->
          <div class="inline-flex p-1 bg-slate-100 rounded-full border border-slate-200 w-full sm:w-auto">
            <button type="button" id="toggle-monthly-btn" onclick="selectPlanCycle('monthly')"
              class="flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-bold bg-slate-900 text-white shadow-xs transition-all cursor-pointer">
              Monthly
            </button>
            <button type="button" id="toggle-yearly-btn" onclick="selectPlanCycle('yearly')"
              class="flex-1 sm:flex-initial px-5 py-2.5 rounded-full text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer flex items-center justify-center gap-1.5">
              <span>Yearly</span>
              <span class="bg-emerald-600 text-white text-[0.62rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Save 20%</span>
            </button>
          </div>

          <!-- Price Card -->
          <div class="space-y-3 mt-4" id="plan-price-display">
            <p class="text-3xl font-black text-slate-900 m-0"><%= currencySymbol %>5,500 <span class="text-xs font-medium text-slate-500">/ Month</span></p>
          </div>

          <!-- Value Proposition Bullet List -->
          <ul class="space-y-3 m-0 p-0 list-none text-xs font-semibold text-slate-700">
            <li class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>Free 30-day trial, cancel anytime with one click</span>
            </li>
            <li class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>We'll send a reminder email 7 days before your trial ends</span>
            </li>
            <li class="flex items-center gap-2.5">
              <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>Unlimited invoicing and expenses analysis</span>
            </li>
          </ul>

          <button type="button" onclick="showPaystackBillingForm()"
            class="w-full sm:w-auto h-12 inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider px-6 rounded-xl cursor-pointer transition-all border-0 shadow-md mt-4">
            <span>Start 30-Day Free Trial</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>

