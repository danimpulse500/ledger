<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <h1 class="text-2xl font-bold text-slate-900 mb-6"><%= title %></h1>

      <% if (errors) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= errors.join(' ') %></div>
      <% } %>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs max-w-lg">
        <form method="POST" action="<%= expense.id ? '/expenses/' + expense.id + '?_method=PUT' : '/expenses' %>" class="space-y-4">
          <div>
            <label for="description" class="block text-xs font-semibold text-slate-600 mb-1.5">Description *</label>
            <input type="text" id="description" name="description" value="<%= expense.description || '' %>" required autofocus class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <label for="amount" class="block text-xs font-semibold text-slate-600 mb-1.5">Amount *</label>
              <input type="number" step="0.01" min="0" id="amount" name="amount" value="<%= expense.amount ?? '' %>" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
            <div class="flex-1">
              <label for="expense_date" class="block text-xs font-semibold text-slate-600 mb-1.5">Date *</label>
              <input type="date" id="expense_date" name="expense_date" value="<%= expense.expense_date || '' %>" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <label for="category" class="block text-xs font-semibold text-slate-600 mb-1.5">Category</label>
              <input type="text" id="category" name="category" value="<%= expense.category || 'General' %>" list="cat-list" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              <datalist id="cat-list">
                <option value="General"><option value="Software"><option value="Travel">
                <option value="Office Supplies"><option value="Marketing"><option value="Utilities">
              </datalist>
            </div>
            <div class="flex-1">
              <label for="vendor" class="block text-xs font-semibold text-slate-600 mb-1.5">Vendor</label>
              <input type="text" id="vendor" name="vendor" value="<%= expense.vendor || '' %>" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
          </div>
          <div class="flex gap-3 pt-3 border-t border-slate-100">
            <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-6 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Save</button>
            <a href="/expenses" class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-slate-100 hover:text-slate-900 transition-all no-underline">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
