<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="min-h-screen flex items-center justify-center bg-slate-50 p-4 py-8">
    <div class="bg-white border border-slate-200 rounded-2xl p-8 md:p-10 w-full max-w-2xl shadow-xs">
      <h1 class="text-2xl font-bold text-slate-900 mb-1">Welcome to <%= currentOrg ? currentOrg.name : 'Your Workspace' %></h1>
      <div class="text-slate-500 text-sm mb-6">Set up your business preferences in 3 quick steps</div>

      <!-- Stepper -->
      <div class="flex items-center justify-between mb-7 pb-5 border-b border-slate-200">
        <div class="flex items-center gap-2.5 text-sm font-semibold <%= step >= 1 ? (step > 1 ? 'text-emerald-600' : 'text-slate-900') : 'text-slate-400' %>">
          <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs font-mono <%= step >= 1 ? (step > 1 ? 'bg-emerald-600 text-white' : 'bg-slate-900 text-white') : 'bg-slate-100 text-slate-400' %>">1</div>
          <span>Branding</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm font-semibold <%= step >= 2 ? (step > 2 ? 'text-emerald-600' : 'text-slate-900') : 'text-slate-400' %>">
          <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs font-mono <%= step >= 2 ? (step > 2 ? 'bg-emerald-600 text-white' : 'bg-slate-900 text-white') : 'bg-slate-100 text-slate-400' %>">2</div>
          <span>Catalog</span>
        </div>
        <div class="flex items-center gap-2.5 text-sm font-semibold <%= step >= 3 ? 'text-slate-900' : 'text-slate-400' %>">
          <div class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs font-mono <%= step >= 3 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-400' %>">3</div>
          <span>Ready</span>
        </div>
      </div>

      <% if (success) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-600 border border-emerald-200"><%= success %></div>
      <% } %>

      <!-- Step 1: Business Details & Currency -->
      <% if (step === 1) { %>
        <form action="/onboarding/settings" method="POST" class="space-y-4">
          <h3 class="text-base font-bold text-slate-900 mb-4">Business Settings & Currency</h3>

          <div class="flex gap-3">
            <div class="flex-1">
              <label for="currency_symbol" class="block text-xs font-semibold text-slate-600 mb-1.5">Currency Symbol</label>
              <select id="currency_symbol" name="currency_symbol" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
                <option value="$" <%= settings.currency_symbol === '$' ? 'selected' : '' %>>$ (USD / CAD / AUD)</option>
                <option value="€" <%= settings.currency_symbol === '€' ? 'selected' : '' %>>€ (EUR)</option>
                <option value="£" <%= settings.currency_symbol === '£' ? 'selected' : '' %>>£ (GBP)</option>
                <option value="₦" <%= settings.currency_symbol === '₦' ? 'selected' : '' %>>₦ (NGN)</option>
                <option value="KSh" <%= settings.currency_symbol === 'KSh' ? 'selected' : '' %>>KSh (KES)</option>
                <option value="R" <%= settings.currency_symbol === 'R' ? 'selected' : '' %>>R (ZAR)</option>
              </select>
            </div>

            <div class="flex-1">
              <label for="invoice_prefix" class="block text-xs font-semibold text-slate-600 mb-1.5">Invoice Prefix</label>
              <input type="text" id="invoice_prefix" name="invoice_prefix" value="<%= settings.invoice_prefix || 'INV-' %>" placeholder="INV-" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
          </div>

          <div>
            <label for="address" class="block text-xs font-semibold text-slate-600 mb-1.5">Business Address</label>
            <input type="text" id="address" name="address" value="<%= settings.address || '' %>" placeholder="123 Business St, Suite 400, New York, NY" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>

          <div class="flex gap-3">
            <div class="flex-1">
              <label for="phone" class="block text-xs font-semibold text-slate-600 mb-1.5">Phone Number</label>
              <input type="text" id="phone" name="phone" value="<%= settings.phone || '' %>" placeholder="+1 (555) 000-1234" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>

            <div class="flex-1">
              <label for="tax_id" class="block text-xs font-semibold text-slate-600 mb-1.5">Tax / VAT ID (Optional)</label>
              <input type="text" id="tax_id" name="tax_id" value="<%= settings.tax_id || '' %>" placeholder="US123456789" class="w-full px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
          </div>

          <div class="flex justify-between items-center mt-6 pt-4 border-t border-slate-200">
            <a href="/" class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-900 transition-all no-underline">Skip Setup</a>
            <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Save & Continue &rarr;</button>
          </div>
        </form>

      <!-- Step 2: Clients & Services -->
      <% } else if (step === 2) { %>
        <div>
          <h3 class="text-base font-bold text-slate-900 mb-1">Add Clients & Products</h3>
          <p class="text-slate-500 text-sm mb-5">Populate your catalog to quickly generate invoices.</p>

          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-3 flex items-center justify-between">
            <div>
              <strong class="text-sm font-bold text-slate-900 block">Client Directory</strong>
              <div class="text-xs text-slate-500"><%= clientCount %> client(s) added</div>
            </div>
            <button type="button" class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-3 py-1.5 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer" data-modal-target="modal-client">+ Add Client</button>
          </div>

          <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-3 flex items-center justify-between">
            <div>
              <strong class="text-sm font-bold text-slate-900 block">Products & Services Catalog</strong>
              <div class="text-xs text-slate-500"><%= productCount %> product(s) added</div>
            </div>
            <button type="button" class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-3 py-1.5 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer" data-modal-target="modal-product">+ Add Product/Service</button>
          </div>

          <div class="flex justify-between items-center mt-6 pt-4 border-t border-slate-200">
            <a href="/onboarding?step=1" class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 py-2 rounded-full hover:bg-slate-100 hover:text-slate-900 transition-all no-underline">&larr; Back</a>
            <a href="/onboarding?step=3" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2 rounded-full hover:bg-slate-800 transition-colors no-underline">Next Step &rarr;</a>
          </div>
        </div>

      <!-- Step 3: First Invoice -->
      <% } else { %>
        <div class="text-center py-4">
          <h2 class="text-xl font-bold text-slate-900 mb-2">Workspace Ready!</h2>
          <p class="text-slate-500 text-sm mb-6 max-w-md mx-auto">
            Your business settings and preferences are saved. You can now issue your first invoice or explore your control dashboard.
          </p>

          <div class="flex gap-3 justify-center">
            <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0" data-modal-target="modal-invoice">Create First Invoice &rarr;</button>
            <a href="/" class="inline-flex items-center gap-1.5 bg-transparent text-slate-900 border border-slate-900 font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-900 hover:text-white transition-all no-underline">Go to Dashboard</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
