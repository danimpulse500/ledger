<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="bg-white text-slate-900 font-sans antialiased">
  <div
    class="min-h-screen w-full flex flex-col lg:flex-row items-center justify-center p-6 lg:p-12 max-w-7xl mx-auto gap-8 lg:gap-12">

    <!-- Left Column: Form -->
    <div class="w-full lg:w-1/2 max-w-lg px-2 sm:px-6 py-4 flex flex-col justify-center">

      <!-- Step Indicator Pills -->
      <div class="flex items-center gap-2 mb-6">
        <div class="w-7 h-1.5 rounded-full <%= step >= 1 ? 'bg-slate-300' : 'bg-slate-200' %>"></div>
        <div class="w-7 h-1.5 rounded-full <%= step >= 1 ? 'bg-[#1e2356]' : 'bg-slate-200' %>"></div>
      </div>

      <% if (step===1) { %>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Almost there...</h1>
        <p class="text-slate-500 text-sm mb-8">Setup organization preferences</p>

        <% if (typeof success !=='undefined' && success) { %>
          <div
            class="p-3.5 rounded-xl text-sm mb-6 bg-emerald-50 text-emerald-600 border border-emerald-200 font-medium">
            <%= success %>
          </div>
          <% } %>

            <form action="/onboarding/settings" method="POST" class="space-y-4">
              <div class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1">
                  <label for="tax_id" class="block text-xs font-semibold text-slate-600 mb-1.5">Tax ID
                    (Optional)</label>
                  <input type="text" id="tax_id" name="tax_id" value="<%= settings.tax_id || '' %>"
                    placeholder="Start typing..."
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
                </div>

                <div class="flex-1">
                  <label for="phone" class="block text-xs font-semibold text-slate-600 mb-1.5">Phone Number</label>
                  <input type="text" id="phone" name="phone" value="<%= settings.phone || '' %>"
                    placeholder="Start typing..."
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <div class="flex-1">
                  <label for="currency_symbol"
                    class="block text-xs font-semibold text-slate-600 mb-1.5">Currency</label>
                  <select id="currency_symbol" name="currency_symbol"
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 transition-colors">
                    <option value="$" <%=settings.currency_symbol==='$' ? 'selected' : '' %>>$ (USD)</option>
                    <option value="€" <%=settings.currency_symbol==='€' ? 'selected' : '' %>>€ (EUR)</option>
                    <option value="£" <%=settings.currency_symbol==='£' ? 'selected' : '' %>>£ (GBP)</option>
                    <option value="₦" <%=settings.currency_symbol==='₦' ? 'selected' : '' %>>₦ (NGN)</option>
                    <option value="KSh" <%=settings.currency_symbol==='KSh' ? 'selected' : '' %>>KSh (KES)</option>
                    <option value="R" <%=settings.currency_symbol==='R' ? 'selected' : '' %>>R (ZAR)</option>
                  </select>
                </div>

                <div class="flex-1">
                  <label for="invoice_prefix" class="block text-xs font-semibold text-slate-600 mb-1.5">Invoice
                    Prefix</label>
                  <input type="text" id="invoice_prefix" name="invoice_prefix"
                    value="<%= settings.invoice_prefix || 'INV-' %>" placeholder="Start typing..."
                    class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
                </div>
              </div>

              <div>
                <label for="address" class="block text-xs font-semibold text-slate-600 mb-1.5">Business Address</label>
                <input type="text" id="address" name="address" value="<%= settings.address || '' %>"
                  placeholder="Start typing..."
                  class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-900 placeholder:text-slate-400 transition-colors">
              </div>

              <div class="pt-4 flex items-center gap-4">
                <button type="submit"
                  class="inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-8 py-3 rounded-full cursor-pointer hover:opacity-90 transition-all border-0 shadow-sm">
                  Sign Up
                </button>
                <a href="/" class="text-xs font-semibold text-slate-500 hover:text-slate-900 no-underline">Skip for
                  now</a>
              </div>
            </form>

            <% } else if (step===2) { %>
              <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mb-2">Catalog Setup</h1>
              <p class="text-slate-500 text-sm mb-6">Add initial customers or products to get started quickly.</p>

              <div class="space-y-4">
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 flex items-center justify-between">
                  <div>
                    <strong class="text-sm font-bold text-slate-900 block">Customer Directory</strong>
                    <div class="text-xs text-slate-500 mt-0.5">
                      <%= clientCount %> customer(s) added
                    </div>
                  </div>
                  <button type="button"
                    class="inline-flex items-center bg-white text-slate-900 border border-slate-900 px-4 py-2 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer"
                    data-modal-target="modal-client">+ Add Customer</button>
                </div>

                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 flex items-center justify-between">
                  <div>
                    <strong class="text-sm font-bold text-slate-900 block">Products & Services Catalog</strong>
                    <div class="text-xs text-slate-500 mt-0.5">
                      <%= productCount %> product(s) added
                    </div>
                  </div>
                  <button type="button"
                    class="inline-flex items-center bg-white text-slate-900 border border-slate-900 px-4 py-2 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer"
                    data-modal-target="modal-product">+ Add Product/Service</button>
                </div>
              </div>

              <div class="pt-6 flex justify-between items-center mt-4">
                <a href="/onboarding?step=1"
                  class="text-xs font-semibold text-slate-500 hover:text-slate-900 no-underline">Back</a>
                <a href="/onboarding?step=3"
                  class="inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-8 py-3 rounded-full no-underline hover:opacity-90 transition-all shadow-sm">Next
                  Step</a>
              </div>

              <% } else { %>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">Workspace Ready!</h1>
                <p class="text-slate-500 text-sm mb-8">Your business settings are saved. You can now issue your first
                  invoice.</p>

                <div class="flex gap-4">
                  <a href="/invoices/new"
                    class="inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-8 py-3 rounded-full no-underline hover:opacity-90 transition-all shadow-sm">Create
                    First Invoice &rarr;</a>
                  <a href="/"
                    class="inline-flex items-center justify-center bg-transparent text-slate-700 border border-slate-300 font-semibold text-sm px-6 py-3 rounded-full no-underline hover:bg-slate-100 transition-all">Go
                    to Dashboard</a>
                </div>
                <% } %>

    </div>

    <!-- Right Column: Illustration Card -->
    <div class="w-full lg:w-1/2 flex items-center justify-center p-4">
      <div
        class="w-full h-full min-h-[420px] lg:min-h-[580px] bg-white border border-slate-200/80 rounded-3xl shadow-xs p-8 flex items-center justify-center relative overflow-hidden">
        <img src="/signup-bg.png" alt="Invoice Illustration" class="max-w-md w-full h-auto object-contain">
      </div>
    </div>

  </div>
</body>

</html>