<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="main">
      <div class="topbar">
        <h1>Products &amp; Services</h1>
        <div class="actions">
          <button type="button" class="btn" data-modal-target="modal-product">+ New Product/Service</button>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <div class="card">
        <% if (products.length === 0) { %>
          <div class="empty-state">
            <h3>No products or services yet</h3>
            <p>Add items you regularly bill for to speed up invoice creation.</p>
            <button type="button" class="btn" data-modal-target="modal-product">+ New Product/Service</button>
          </div>
        <% } else { %>
          <table>
            <thead><tr><th>Name</th><th>Description</th><th class="money">Unit Price</th><th>Discount %</th><th></th></tr></thead>
            <tbody>
              <% products.forEach(p => { %>
                <tr>
                  <td><%= p.name %></td>
                  <td class="text-soft"><%= p.description %></td>
                  <td class="money"><%= currencySymbol %><%= p.unit_price.toFixed(2) %></td>
                  <td class="figure"><%= p.tax_rate %>%</td>
                  <td class="actions-cell" onclick="event.stopPropagation()">
                    <div class="action-dropdown">
                      <button type="button" class="action-dropdown-btn" onclick="toggleActionDropdown(event, this)" title="Actions">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="1.2"></circle>
                          <circle cx="12" cy="5" r="1.2"></circle>
                          <circle cx="12" cy="19" r="1.2"></circle>
                        </svg>
                      </button>
                      <div class="action-dropdown-menu">
                        <a href="/products/<%= p.id %>/edit">Edit Product</a>
                        <form method="POST" action="/products/<%= p.id %>?_method=DELETE" style="display:block;" onsubmit="return confirm('Delete this product?');">
                          <button type="submit" class="text-danger">Delete Product</button>
                        </form>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
  <script>
    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const dropdown = btn.closest('.action-dropdown');
      const wasActive = dropdown.classList.contains('active');
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      if (!wasActive) {
        dropdown.classList.add('active');
      }
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.action-dropdown')) {
        document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      }
    });
  </script>
</body>
</html>
