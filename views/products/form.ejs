<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <h1 class="text-2xl font-bold text-slate-900 mb-6"><%= title %></h1>

      <% if (errors) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= errors.join(' ') %></div>
      <% } %>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs max-w-lg">
        <form method="POST" action="<%= product.id ? '/products/' + product.id + '?_method=PUT' : '/products' %>" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-slate-600 mb-1.5">Name *</label>
            <input type="text" id="name" name="name" value="<%= product.name || '' %>" required autofocus class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
          </div>
          <div>
            <label for="description" class="block text-xs font-semibold text-slate-600 mb-1.5">Description</label>
            <textarea id="description" name="description" rows="3" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y"><%= product.description || '' %></textarea>
          </div>
          <div class="flex gap-4">
            <div class="flex-1">
              <label for="unit_price" class="block text-xs font-semibold text-slate-600 mb-1.5">Unit price *</label>
              <input type="number" step="0.01" min="0" id="unit_price" name="unit_price" value="<%= product.unit_price ?? '' %>" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
            <div class="flex-1">
              <label for="tax_rate" class="block text-xs font-semibold text-slate-600 mb-1.5">Discount (%)</label>
              <input type="number" step="0.01" min="0" id="tax_rate" name="tax_rate" value="<%= product.tax_rate ?? 0 %>" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
            </div>
          </div>
          <div class="flex gap-3 pt-3 border-t border-slate-100">
            <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-6 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Save</button>
            <a href="/products" class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-6 py-2.5 rounded-full hover:bg-slate-100 hover:text-slate-900 transition-all no-underline">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
