<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <div class="flex justify-between items-center mb-6 gap-4 flex-wrap">
        <h1 class="text-2xl font-bold text-slate-900 m-0">Clients</h1>
        <div class="flex gap-2.5">
          <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0" data-modal-target="modal-client">+ New Client</button>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= error %></div>
      <% } %>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
        <form method="GET" class="flex gap-2.5 mb-5 items-center">
          <input type="text" name="q" placeholder="Search clients..." value="<%= q %>" class="px-3.5 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 w-64">
          <button class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-4 py-2 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer" type="submit">Search</button>
        </form>

        <% if (clients.length === 0) { %>
          <div class="py-12 text-center text-slate-500">
            <h3 class="text-lg font-bold text-slate-900 mb-1">No clients yet</h3>
            <p class="text-sm mb-4">Add your first client to start invoicing.</p>
            <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0" data-modal-target="modal-client">+ New Client</button>
          </div>
        <% } else { %>
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                <th class="py-2.5 px-3">Name</th>
                <th class="py-2.5 px-3">Email</th>
                <th class="py-2.5 px-3">Phone</th>
                <th class="py-2.5 px-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% clients.forEach(c => { %>
                <tr class="hover:bg-slate-50 cursor-pointer transition-colors" onclick="window.location='/clients/<%= c.id %>'">
                  <td class="py-3 px-3"><a href="/clients/<%= c.id %>" onclick="event.stopPropagation()" class="font-semibold text-slate-900 no-underline hover:underline"><%= c.name %></a></td>
                  <td class="py-3 px-3 text-slate-600"><%= c.email %></td>
                  <td class="py-3 px-3 text-slate-600"><%= c.phone %></td>
                  <td class="py-3 px-3 text-right" onclick="event.stopPropagation()">
                    <div class="action-dropdown relative inline-block text-left">
                      <button type="button" class="w-8 h-8 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 inline-flex items-center justify-center border-0 bg-transparent cursor-pointer" onclick="toggleActionDropdown(event, this)" title="Actions">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="1.2"></circle>
                          <circle cx="12" cy="5" r="1.2"></circle>
                          <circle cx="12" cy="19" r="1.2"></circle>
                        </svg>
                      </button>
                      <div class="action-dropdown-menu absolute right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 min-w-[140px] py-1 text-left">
                        <a href="/clients/<%= c.id %>" class="block px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 no-underline">View Client</a>
                        <a href="/clients/<%= c.id %>/edit" class="block px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 no-underline">Edit Client</a>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
  <script>
    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const dropdown = btn.closest('.action-dropdown');
      const wasActive = dropdown.classList.contains('active');
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      if (!wasActive) {
        dropdown.classList.add('active');
      }
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.action-dropdown')) {
        document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      }
    });
  </script>
</body>
</html>
