<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="main">
      <div class="topbar">
        <h1>Clients</h1>
        <div class="actions">
          <button type="button" class="btn" data-modal-target="modal-client">+ New Client</button>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <div class="card">
        <form method="GET" class="filter-bar" style="margin-bottom:14px;">
          <input type="text" name="q" placeholder="Search clients..." value="<%= q %>">
          <button class="btn btn-outline btn-sm" type="submit">Search</button>
        </form>

        <% if (clients.length === 0) { %>
          <div class="empty-state">
            <h3>No clients yet</h3>
            <p>Add your first client to start invoicing.</p>
            <button type="button" class="btn" data-modal-target="modal-client">+ New Client</button>
          </div>
        <% } else { %>
          <table>
            <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody>
              <% clients.forEach(c => { %>
                <tr class="clickable-row" onclick="window.location='/clients/<%= c.id %>'">
                  <td><a href="/clients/<%= c.id %>" onclick="event.stopPropagation()"><strong><%= c.name %></strong></a></td>
                  <td><%= c.email %></td>
                  <td><%= c.phone %></td>
                  <td class="actions-cell" onclick="event.stopPropagation()">
                    <div class="action-dropdown">
                      <button type="button" class="action-dropdown-btn" onclick="toggleActionDropdown(event, this)" title="Actions">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="1.2"></circle>
                          <circle cx="12" cy="5" r="1.2"></circle>
                          <circle cx="12" cy="19" r="1.2"></circle>
                        </svg>
                      </button>
                      <div class="action-dropdown-menu">
                        <a href="/clients/<%= c.id %>">View Client</a>
                        <a href="/clients/<%= c.id %>/edit">Edit Client</a>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
  <script>
    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const dropdown = btn.closest('.action-dropdown');
      const wasActive = dropdown.classList.contains('active');
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      if (!wasActive) {
        dropdown.classList.add('active');
      }
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.action-dropdown')) {
        document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      }
    });
  </script>
</body>
</html>
