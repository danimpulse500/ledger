<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <div class="flex justify-between items-start mb-6 gap-4 flex-wrap">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 m-0"><%= clientRecord.name %></h1>
          <p class="text-slate-500 text-sm mt-1 m-0"><%= clientRecord.email %> <%= clientRecord.phone ? '· ' + clientRecord.phone : '' %></p>
        </div>
        <div class="flex items-center gap-2.5">
          <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0" data-modal-target="modal-invoice" data-client-id="<%= clientRecord.id %>">+ New Invoice</button>
          
          <a href="/clients/<%= clientRecord.id %>/edit" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-slate-50 transition-all no-underline" aria-label="Edit Customer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span class="btn-label font-semibold text-xs text-slate-700">Edit</span>
          </a>
          
          <form method="POST" action="/clients/<%= clientRecord.id %>?_method=DELETE" onsubmit="return confirm('Delete this customer? This cannot be undone.');" class="inline">
            <button type="submit" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-all" aria-label="Delete Customer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span class="btn-label font-semibold text-xs">Delete</span>
            </button>
          </form>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= error %></div>
      <% } %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 m-0">Details</h3>
          <p class="text-slate-600 text-sm whitespace-pre-line m-0 mb-3"><%= clientRecord.address || 'No address on file' %></p>
          <% if (clientRecord.tax_id) { %><p class="text-xs text-slate-400 m-0 mb-2">Tax ID: <%= clientRecord.tax_id %></p><% } %>
          <% if (clientRecord.notes) { %>
            <hr class="border-t border-slate-200 my-4">
            <p class="text-sm text-slate-600 m-0"><%= clientRecord.notes %></p>
          <% } %>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 m-0">Invoice history</h3>
          <% if (invoices.length === 0) { %>
            <p class="text-slate-500 text-sm m-0">No invoices for this customer yet.</p>
          <% } else { %>
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                  <th class="py-2.5 px-3">Invoice</th>
                  <th class="py-2.5 px-3">Status</th>
                  <th class="py-2.5 px-3 font-mono text-right">Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% invoices.forEach(inv => { %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-2.5 px-3"><a href="/invoices/<%= inv.id %>" class="font-mono font-semibold text-slate-900 no-underline hover:underline"><%= inv.invoice_number %></a></td>
                    <td class="py-2.5 px-3"><span class="badge badge-<%= inv.status %>"><%= inv.status %></span></td>
                    <td class="py-2.5 px-3 font-mono text-right font-semibold text-slate-900"><%= currencySymbol %><%= inv.total.toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
