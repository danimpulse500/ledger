<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="main">
      <div class="topbar">
        <div>
          <h1><%= clientRecord.name %></h1>
          <p class="text-soft"><%= clientRecord.email %> <%= clientRecord.phone ? '· ' + clientRecord.phone : '' %></p>
        </div>
        <div class="actions">
          <button type="button" class="btn" data-modal-target="modal-invoice" data-client-id="<%= clientRecord.id %>">+ New Invoice</button>
          <a href="/clients/<%= clientRecord.id %>/edit" class="btn btn-expandable" aria-label="Edit Client">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span class="btn-label">Edit</span>
          </a>
          <form method="POST" action="/clients/<%= clientRecord.id %>?_method=DELETE" onsubmit="return confirm('Delete this client? This cannot be undone.');" style="display:inline;">
            <button type="submit" class="btn btn-expandable btn-expandable-danger" aria-label="Delete Client">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span class="btn-label">Delete</span>
            </button>
          </form>
        </div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <div class="grid grid-2" style="align-items:start;">
        <div class="card">
          <h3>Details</h3>
          <p class="text-soft" style="white-space:pre-line;"><%= clientRecord.address || 'No address on file' %></p>
          <% if (clientRecord.tax_id) { %><p class="text-faint">Tax ID: <%= clientRecord.tax_id %></p><% } %>
          <% if (clientRecord.notes) { %><hr class="divider"><p><%= clientRecord.notes %></p><% } %>
        </div>
        <div class="card">
          <h3>Invoice history</h3>
          <% if (invoices.length === 0) { %>
            <p class="text-soft">No invoices for this client yet.</p>
          <% } else { %>
            <table class="compact">
              <thead><tr><th>Invoice</th><th>Status</th><th class="money">Total</th></tr></thead>
              <tbody>
                <% invoices.forEach(inv => { %>
                  <tr>
                    <td><a href="/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></td>
                    <td><span class="badge badge-<%= inv.status %>"><%= inv.status %></span></td>
                    <td class="money"><%= currencySymbol %><%= inv.total.toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
