      </div> -->
      </div>
  </div>

  <script>
    const logoInput = document.getElementById('invoice_logo');
    const logoDropzone = document.getElementById('logo-dropzone');
    const logoPreview = document.getElementById('logo-preview');
    const logoDropzoneContent = document.querySelector('.logo-dropzone-content');

    function previewLogo(file) {
      if (!file || !['image/png', 'image/jpeg'].includes(file.type)) return;
      logoPreview.src = URL.createObjectURL(file);
      logoPreview.hidden = false;
      logoDropzoneContent.hidden = true;
      logoDropzone.classList.add('has-preview');
    }

    logoInput.addEventListener('change', () => previewLogo(logoInput.files[0]));

    ['dragenter', 'dragover'].forEach(eventName => logoDropzone.addEventListener(eventName, event => {
      event.preventDefault();
      logoDropzone.classList.add('is-dragging');
    }));

    ['dragleave', 'drop'].forEach(eventName => logoDropzone.addEventListener(eventName, event => {
      event.preventDefault();
      logoDropzone.classList.remove('is-dragging');
    }));

    logoDropzone.addEventListener('drop', event => {
      const file = event.dataTransfer.files[0];
      if (file) {
        logoInput.files = event.dataTransfer.files;
        previewLogo(file);
      }
    });
  </script>
</body>

</html>