<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('partials/sidebar') %>

    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <header class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-slate-900 m-0">Settings</h1>
        <span class="bg-slate-100 text-slate-700 font-semibold px-3 py-1 rounded-full text-xs uppercase tracking-wider">Company profile</span>
      </header>

      <% if (error) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200">
          <%= error %>
        </div>
      <% } %>
      <% if (success) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-emerald-50 text-emerald-600 border border-emerald-200">
          <%= success %>
        </div>
      <% } %>

      <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-xs">
        <form method="POST" action="/settings" enctype="multipart/form-data">

          <!-- COMPANY DETAILS -->
          <fieldset class="border-0 p-0 m-0">
            <legend class="font-bold text-lg pb-2 border-b-2 border-slate-200 w-full text-slate-900">
              Company details
            </legend>

            <div class="flex gap-4 mt-4">
              <div class="flex-1">
                <label for="company_name" class="block text-xs font-semibold text-slate-600 mb-1.5">Company name</label>
                <input type="text" id="company_name" name="company_name" value="<%= settings.company_name %>" placeholder="e.g. Acme Inc." class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
              <div class="flex-1">
                <label for="currency_symbol" class="block text-xs font-semibold text-slate-600 mb-1.5">Currency symbol</label>
                <input type="text" id="currency_symbol" name="currency_symbol" value="<%= settings.currency_symbol %>" placeholder="$" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
            </div>

            <div class="mt-4">
              <label for="address" class="block text-xs font-semibold text-slate-600 mb-1.5">Address</label>
              <textarea id="address" name="address" rows="3" placeholder="Street, city, postal code" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 resize-y"><%= settings.address %></textarea>
            </div>

            <div class="flex gap-4 mt-4">
              <div class="flex-1">
                <label for="email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email</label>
                <input type="email" id="email" name="email" value="<%= settings.email %>" placeholder="billing@company.com" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
              <div class="flex-1">
                <label for="phone" class="block text-xs font-semibold text-slate-600 mb-1.5">Phone</label>
                <input type="tel" id="phone" name="phone" value="<%= settings.phone %>" placeholder="+1 234 567 890" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
            </div>

            <div class="flex gap-4 mt-4">
              <div class="flex-1">
                <label for="tax_id" class="block text-xs font-semibold text-slate-600 mb-1.5">Tax / VAT ID</label>
                <input type="text" id="tax_id" name="tax_id" value="<%= settings.tax_id %>" placeholder="VAT-123456" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
              <div class="flex-1">
                <label for="invoice_prefix" class="block text-xs font-semibold text-slate-600 mb-1.5">Invoice number prefix</label>
                <input type="text" id="invoice_prefix" name="invoice_prefix" value="<%= settings.invoice_prefix %>" placeholder="INV-" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
              <div class="flex-1">
                <label for="default_tax_rate" class="block text-xs font-semibold text-slate-600 mb-1.5">Default discount (%)</label>
                <input type="number" id="default_tax_rate" step="0.01" name="default_tax_rate" value="<%= settings.default_tax_rate %>" placeholder="0.00" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
            </div>
          </fieldset>

          <hr class="my-8 border-t border-slate-200">

          <!-- INVOICE SETTINGS -->
          <fieldset class="border-0 p-0 m-0">
            <legend class="font-bold text-lg pb-2 border-b-2 border-slate-200 w-full text-slate-900">
              Invoice settings
            </legend>

            <div class="mt-4">
              <label for="invoice_logo" class="block text-xs font-semibold text-slate-600 mb-1.5">Invoice logo</label>
              <label class="logo-dropzone <%= settings.invoice_logo_path ? 'has-preview' : '' %> flex flex-col items-center justify-center border-2 border-dashed border-slate-300 rounded-xl p-8 bg-slate-50 transition-colors cursor-pointer min-h-[150px] hover:border-slate-900 hover:bg-slate-100" for="invoice_logo" id="logo-dropzone">
                <input type="file" id="invoice_logo" name="invoice_logo" accept="image/png,image/jpeg" class="hidden">
                <span class="logo-dropzone-content text-center text-slate-500" <%= settings.invoice_logo_path ? 'hidden' : '' %>>
                  <strong class="block text-base font-bold text-slate-900 mb-1">Drop your logo here</strong>
                  <span class="text-xs">or click to browse (PNG or JPG, max 2 MB)</span>
                </span>
                <img id="logo-preview" class="logo-preview max-h-[120px] max-w-full object-contain" src="<%= settings.invoice_logo_path ? '/settings/logo' : '' %>" alt="Invoice logo preview" <%= settings.invoice_logo_path ? '' : 'hidden' %>>
              </label>
            </div>

            <div class="space-y-4 mt-6">
              <div class="flex justify-between items-center py-3 border-b border-slate-100">
                <div>
                  <span class="font-semibold text-sm text-slate-900 block">Display logo on invoices</span>
                  <p class="text-xs text-slate-500 mt-1 m-0">Show your custom business logo at the top header of all generated invoice PDFs and web previews.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer shrink-0 ml-4">
                  <input type="checkbox" name="invoice_logo_enabled" <%= settings.invoice_logo_enabled ? 'checked' : '' %> class="sr-only peer">
                  <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-900"></div>
                </label>
              </div>

              <div class="flex justify-between items-center py-3">
                <div>
                  <span class="font-semibold text-sm text-slate-900 block">Display company name on invoices</span>
                  <p class="text-xs text-slate-500 mt-1 m-0">Include your registered business name alongside or beneath the main logo section.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer shrink-0 ml-4">
                  <input type="checkbox" name="invoice_company_name_enabled" <%= settings.invoice_company_name_enabled !== 0 ? 'checked' : '' %> class="sr-only peer">
                  <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-slate-900"></div>
                </label>
              </div>
            </div>
          </fieldset>

          <div class="flex justify-end gap-2 mt-8">
            <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-8 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Save Settings</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const logoInput = document.getElementById('invoice_logo');
    const logoDropzone = document.getElementById('logo-dropzone');
    const logoPreview = document.getElementById('logo-preview');
    const logoDropzoneContent = document.querySelector('.logo-dropzone-content');

    function previewLogo(file) {
      if (!file || !['image/png', 'image/jpeg'].includes(file.type)) return;
      logoPreview.src = URL.createObjectURL(file);
      logoPreview.hidden = false;
      logoDropzoneContent.hidden = true;
      logoDropzone.classList.add('has-preview');
    }

    logoInput.addEventListener('change', () => previewLogo(logoInput.files[0]));

    ['dragenter', 'dragover'].forEach(eventName => logoDropzone.addEventListener(eventName, event => {
      event.preventDefault();
      logoDropzone.classList.add('is-dragging');
    }));

    ['dragleave', 'drop'].forEach(eventName => logoDropzone.addEventListener(eventName, event => {
      event.preventDefault();
      logoDropzone.classList.remove('is-dragging');
    }));

    logoDropzone.addEventListener('drop', event => {
      const file = event.dataTransfer.files[0];
      if (file) {
        logoInput.files = event.dataTransfer.files;
        previewLogo(file);
      }
    });
  </script>
</body>

</html>