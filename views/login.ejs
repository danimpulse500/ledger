<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-slate-900 font-sans antialiased">
  <div class="min-h-screen flex items-center justify-center bg-slate-900 p-4">
    <div class="bg-white p-10 rounded-2xl w-full max-w-sm shadow-2xl border border-slate-800">
      <h1 class="text-2xl font-black text-center text-slate-900 mb-1 uppercase tracking-tight">Ledger</h1>
      <div class="text-center text-slate-500 text-sm mb-6">Sign in to manage invoices</div>
      <% if (error) { %>
        <div class="p-3 rounded-lg text-sm mb-4 bg-red-50 text-red-600 border border-red-200"><%= error %></div>
      <% } %>
      <form method="POST" action="/login" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-600 mb-1.5">Email</label>
          <input type="email" id="email" name="email" required autofocus class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div>
          <label for="password" class="block text-xs font-semibold text-slate-600 mb-1.5">Password</label>
          <input type="password" id="password" name="password" required class="w-full px-3.5 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <button type="submit" class="w-full inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-4 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Log in</button>
      </form>
      <div class="text-center mt-5 text-sm text-slate-500">
        Don't have a workspace? <a href="/signup" class="text-slate-900 font-semibold no-underline hover:underline">Start a free trial</a>
      </div>
    </div>
  </div>
</body>
</html>
