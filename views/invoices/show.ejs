<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <div class="flex justify-between items-start mb-6 gap-4 flex-wrap no-print">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 m-0 flex items-center gap-3">
            <%= invoice.invoice_number %> <span class="badge badge-<%= invoice.status %>"><%= invoice.status %></span>
          </h1>
          <p class="text-slate-500 text-sm mt-1 m-0"><%= invoice.client_name %></p>
        </div>
        <div class="flex items-center gap-2.5 flex-wrap">
          <% if (invoice.status === 'draft') { %>
            <form method="POST" action="/invoices/<%= invoice.id %>/status" class="inline">
              <input type="hidden" name="status" value="sent">
              <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Publish & Mark Sent</button>
            </form>
          <% } %>
          
          <!-- Status Dropdown Selector -->
          <div class="action-dropdown relative inline-block text-left" onclick="event.stopPropagation()">
            <button type="button" class="inline-flex items-center gap-1.5 bg-white text-slate-700 border border-slate-200 rounded-full px-4 py-2 text-sm font-semibold hover:bg-slate-50 transition-colors cursor-pointer" onclick="toggleActionDropdown(event, this)">
              <span><%= invoice.status.charAt(0).toUpperCase() + invoice.status.slice(1) %></span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-0.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="action-dropdown-menu absolute right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-xl z-50 min-w-[160px] py-1 text-left">
              <% ['draft','sent','paid','overdue','cancelled'].forEach(s => { %>
                <form method="POST" action="/invoices/<%= invoice.id %>/status" class="block">
                  <input type="hidden" name="status" value="<%= s %>">
                  <button type="submit" class="w-full text-left px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-100 bg-transparent border-0 cursor-pointer">
                    <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                  </button>
                </form>
              <% }) %>
            </div>
          </div>

          <!-- Action Buttons -->
          <button type="button" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-slate-50 transition-all" onclick="openEmailModal()" aria-label="Send Email">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            <span class="btn-label font-semibold text-xs text-slate-700">Send Email</span>
          </button>
          
          <a href="/invoices/<%= invoice.id %>/pdf" target="_blank" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-slate-50 transition-all no-underline" aria-label="Download PDF">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="btn-label font-semibold text-xs text-slate-700">Download PDF</span>
          </a>
          
          <a href="/invoices/<%= invoice.id %>/edit" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-slate-50 transition-all no-underline" aria-label="Edit Invoice">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span class="btn-label font-semibold text-xs text-slate-700">Edit</span>
          </a>
          
          <form method="POST" action="/invoices/<%= invoice.id %>?_method=DELETE" onsubmit="return confirm('Delete this invoice? This cannot be undone.');" class="inline">
            <button type="submit" class="btn-expandable inline-flex items-center justify-center gap-0 h-9.5 px-3 rounded-full bg-white text-slate-700 border border-slate-200 cursor-pointer hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-all" aria-label="Delete Invoice">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span class="btn-label font-semibold text-xs">Delete</span>
            </button>
          </form>
        </div>
      </div>

      <% if (typeof emailSent !== 'undefined' && emailSent) { %>
        <div class="p-3.5 rounded-xl text-sm mb-6 bg-emerald-50 text-emerald-700 border border-emerald-200 no-print">
          <strong>Email Notification:</strong> <%= typeof msg !== 'undefined' && msg ? msg : 'Invoice email dispatched successfully with PDF attachment.' %>
        </div>
      <% } %>
      <% if (typeof emailError !== 'undefined' && emailError && emailError.length > 0) { %>
        <div class="p-3.5 rounded-xl text-sm mb-6 bg-red-50 text-red-700 border border-red-200 no-print">
          <strong>Email Alert:</strong> <%= emailError %>
        </div>
      <% } %>

      <div class="flex flex-col lg:flex-row gap-6 items-start">
        <!-- Left Panel: Invoice Sheet -->
        <div class="flex-1 min-w-0 w-full">
          <div class="invoice-doc bg-white border border-slate-200 rounded-2xl p-10 max-w-3xl shadow-xs">
            <div class="flex justify-between mb-8">
              <div>
                <h1 class="text-2xl font-bold text-slate-900 mb-1"><%= settings.company_name %></h1>
                <p class="text-slate-500 text-sm whitespace-pre-line m-0"><%= settings.address %></p>
                <p class="text-slate-500 text-sm m-0 mt-1"><%= settings.email %> <%= settings.phone ? '· ' + settings.phone : '' %></p>
              </div>
              <div class="text-right">
                <h2 class="text-xl font-bold text-slate-900 mb-1">Invoice</h2>
                <div class="font-mono text-slate-500 text-sm"><%= invoice.invoice_number %></div>
              </div>
            </div>

            <div class="flex justify-between mb-7 gap-8">
              <div class="flex-1">
                <h4 class="text-[0.72rem] uppercase tracking-wider text-slate-500 font-semibold mb-1.5">Billed to</h4>
                <div class="font-bold text-slate-900 text-sm"><%= invoice.client_name %></div>
                <div class="text-slate-500 text-sm whitespace-pre-line"><%= invoice.client_address %></div>
                <div class="text-slate-500 text-sm"><%= invoice.client_email %></div>
                <% if (invoice.client_tax_id) { %><div class="text-slate-400 text-xs mt-1">Tax ID: <%= invoice.client_tax_id %></div><% } %>
              </div>
              <div class="flex-1 text-right text-sm text-slate-600 space-y-1">
                <h4 class="text-[0.72rem] uppercase tracking-wider text-slate-500 font-semibold mb-1.5">Details</h4>
                <div>Issue date: <span class="font-mono font-semibold text-slate-900"><%= invoice.issue_date %></span></div>
                <div>Due date: <span class="font-mono font-semibold text-slate-900"><%= invoice.due_date %></span></div>
              </div>
            </div>

            <table class="w-full border-collapse text-sm mb-6">
              <thead>
                <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                  <th class="py-2.5 px-3">Description</th>
                  <th class="py-2.5 px-3 font-mono">Qty</th>
                  <th class="py-2.5 px-3 font-mono text-right">Unit Price</th>
                  <th class="py-2.5 px-3 font-mono">Discount</th>
                  <th class="py-2.5 px-3 font-mono text-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% items.forEach(it => { %>
                  <tr>
                    <td class="py-3 px-3 text-slate-800"><%= it.description %></td>
                    <td class="py-3 px-3 font-mono text-slate-600"><%= it.quantity %></td>
                    <td class="py-3 px-3 font-mono text-right text-slate-600"><%= currencySymbol %><%= it.unit_price.toFixed(2) %></td>
                    <td class="py-3 px-3 font-mono text-slate-600"><%= it.tax_rate %>%</td>
                    <td class="py-3 px-3 font-mono text-right font-semibold text-slate-900"><%= currencySymbol %><%= it.line_total.toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>

            <div class="w-72 ml-auto space-y-1.5 text-sm">
              <div class="flex justify-between text-slate-600"><span>Subtotal</span><span class="font-mono text-slate-900"><%= currencySymbol %><%= invoice.subtotal.toFixed(2) %></span></div>
              <div class="flex justify-between text-slate-600"><span>Discount</span><span class="font-mono text-slate-900"><%= currencySymbol %><%= invoice.tax_total.toFixed(2) %></span></div>
              <div class="flex justify-between pt-2 border-t-2 border-slate-900 font-bold text-base text-slate-900"><span>Total</span><span class="font-mono"><%= currencySymbol %><%= invoice.total.toFixed(2) %></span></div>
              <div class="flex justify-between text-slate-600"><span>Paid</span><span class="font-mono text-slate-900"><%= currencySymbol %><%= invoice.amount_paid.toFixed(2) %></span></div>
              <div class="flex justify-between font-bold text-slate-900"><span>Balance due</span><span class="font-mono"><%= currencySymbol %><%= (invoice.total - invoice.amount_paid).toFixed(2) %></span></div>
            </div>

            <% if (invoice.notes) { %>
              <hr class="border-t border-slate-200 my-6">
              <p class="text-slate-500 text-sm m-0"><%= invoice.notes %></p>
            <% } %>
          </div>
        </div>

        <!-- Right Panel: Stacked Management Cards -->
        <div class="w-full lg:w-90 shrink-0 space-y-4 no-print">
          <!-- Record Payment Card -->
          <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
            <h3 class="text-base font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 m-0">Record Payment</h3>
            <form method="POST" action="/invoices/<%= invoice.id %>/payments" class="space-y-4">
              <div class="flex gap-3">
                <div class="flex-1">
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Amount ($)</label>
                  <input type="number" name="amount" step="0.01" min="0" value="<%= Math.max(0, invoice.total - invoice.amount_paid).toFixed(2) %>" required placeholder="0.00" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
                </div>
                <div class="flex-1">
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Date</label>
                  <input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
                </div>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Method</label>
                <input type="text" name="method" placeholder="Bank transfer, card, cash..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
              </div>
              <button type="submit" class="w-full inline-flex items-center justify-center bg-slate-900 text-white font-semibold text-sm px-4 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Record Payment</button>
            </form>

            <% if (payments.length > 0) { %>
              <hr class="border-t border-slate-200 my-4">
              <ul class="space-y-2 p-0 m-0 list-none text-sm">
                <% payments.forEach(p => { %>
                  <li class="flex justify-between items-center py-1.5 border-b border-slate-100 last:border-0">
                    <span><span class="font-mono font-semibold text-slate-900"><%= currencySymbol %><%= p.amount.toFixed(2) %></span> on <%= p.payment_date %> <span class="text-xs text-slate-400"><%= p.method %></span></span>
                    <form method="POST" action="/invoices/<%= invoice.id %>/payments/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Remove this payment?');" class="m-0">
                      <button type="submit" class="bg-transparent text-slate-400 border border-slate-200 px-2 py-0.5 text-xs font-semibold rounded-full hover:bg-red-50 hover:text-red-600 hover:border-red-200 cursor-pointer">Remove</button>
                    </form>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Email Invoice Modal -->
  <div id="email-modal-overlay" class="modal-overlay fixed inset-0 bg-slate-900/45 backdrop-blur-xs z-[1000] items-center justify-center p-4" onclick="closeEmailModal(event)">
    <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl border border-slate-100" onclick="event.stopPropagation()">
      <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100">
        <h3 class="text-base font-bold text-slate-900 m-0">Email Invoice</h3>
        <button type="button" class="modal-close-btn bg-transparent border-0 text-slate-400 cursor-pointer p-1 rounded-md hover:text-slate-900 transition-colors" onclick="closeEmailModal()">&times;</button>
      </div>
      <form method="POST" action="/invoices/<%= invoice.id %>/send" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Recipient Email</label>
          <input type="email" name="recipient_email" value="<%= invoice.client_email || 'daviddominic767@gmail.com' %>" required placeholder="client@example.com" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Custom Note (Optional)</label>
          <textarea name="custom_note" placeholder="Add an optional message to your client..." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white text-slate-900 focus:outline-none focus:border-slate-400 min-h-[60px] resize-y"></textarea>
        </div>
        <div class="flex justify-end gap-2.5 mt-6 pt-3 border-t border-slate-100">
          <button type="button" class="inline-flex items-center gap-1.5 bg-transparent text-slate-600 border border-slate-200 font-semibold text-sm px-4 py-2 rounded-full cursor-pointer hover:bg-slate-100 hover:text-slate-900 transition-all" onclick="closeEmailModal()">Cancel</button>
          <button type="submit" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0">Send Email with PDF</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const dropdown = btn.closest('.action-dropdown');
      const wasActive = dropdown.classList.contains('active');
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      if (!wasActive) {
        dropdown.classList.add('active');
      }
    }

    function openEmailModal() {
      document.getElementById('email-modal-overlay').classList.add('active');
    }

    function closeEmailModal(event) {
      if (!event || event.target.id === 'email-modal-overlay' || event.target.classList.contains('modal-close-btn') || event.target.closest('.modal-close-btn')) {
        document.getElementById('email-modal-overlay').classList.remove('active');
      }
    }

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.action-dropdown')) {
        document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeEmailModal();
      }
    });
  </script>
</body>
</html>
