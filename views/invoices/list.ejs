<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="main">
      <div class="topbar">
        <h1>Invoices</h1>
        <div class="actions">
          <button type="button" class="btn" data-modal-target="modal-invoice">+ New Invoice</button>
        </div>
      </div>

      <div class="card">
        <form method="GET" class="filter-bar">
          <input type="text" name="q" placeholder="Search invoice # or client..." value="<%= q %>">
          <select name="status" onchange="this.form.submit()">
            <option value="">All statuses</option>
            <% ['draft','sent','paid','overdue','cancelled'].forEach(s => { %>
              <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }) %>
          </select>
          <button class="btn btn-outline btn-sm" type="submit">Filter</button>
        </form>
        <hr class="divider">

        <% if (invoices.length === 0) { %>
          <div class="empty-state">
            <h3>No invoices found</h3>
            <p>Create your first invoice to get started.</p>
            <button type="button" class="btn" data-modal-target="modal-invoice">+ New Invoice</button>
          </div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Client</th>
                <th>Issued</th>
                <th>Due</th>
                <th>Status</th>
                <th class="money">Total</th>
                <th class="money">Balance</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% invoices.forEach(inv => { %>
                <tr class="clickable-row" onclick="window.location='/invoices/<%= inv.id %>'">
                  <td><a href="/invoices/<%= inv.id %>" onclick="event.stopPropagation()"><strong class="figure"><%= inv.invoice_number %></strong></a></td>
                  <td><%= inv.client_name %></td>
                  <td><%= inv.issue_date %></td>
                  <td><%= inv.due_date %></td>
                  <td><span class="badge badge-<%= inv.status %>"><%= inv.status %></span></td>
                  <td class="money"><%= currencySymbol %><%= inv.total.toFixed(2) %></td>
                  <td class="money"><%= (inv.total - inv.amount_paid) > 0 ? currencySymbol + (inv.total - inv.amount_paid).toFixed(2) : '—' %></td>
                  <td class="actions-cell" onclick="event.stopPropagation()">
                    <div class="action-dropdown">
                      <button type="button" class="action-dropdown-btn" onclick="toggleActionDropdown(event, this)" title="Actions">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="1.2"></circle>
                          <circle cx="12" cy="5" r="1.2"></circle>
                          <circle cx="12" cy="19" r="1.2"></circle>
                        </svg>
                      </button>
                      <div class="action-dropdown-menu">
                        <a href="/invoices/<%= inv.id %>">View Details</a>
                        <a href="/invoices/<%= inv.id %>/edit">Edit Invoice</a>
                        <a href="/invoices/<%= inv.id %>/pdf" target="_blank">Download PDF</a>
                        <% if (inv.status === 'draft') { %>
                          <form method="POST" action="/invoices/<%= inv.id %>/status" style="display:block;">
                            <input type="hidden" name="status" value="sent">
                            <input type="hidden" name="redirect" value="/invoices">
                            <button type="submit">Publish & Mark Sent</button>
                          </form>
                        <% } %>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  <script>
    function toggleActionDropdown(event, btn) {
      event.stopPropagation();
      const dropdown = btn.closest('.action-dropdown');
      const wasActive = dropdown.classList.contains('active');
      document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      if (!wasActive) {
        dropdown.classList.add('active');
      }
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.action-dropdown')) {
        document.querySelectorAll('.action-dropdown.active').forEach(d => d.classList.remove('active'));
      }
    });
  </script>
</body>
</html>
