<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <style>
    .platform-login-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-dark);
    }
    .platform-login-card {
      background: var(--surface);
      padding: 40px 36px;
      border-radius: 10px;
      width: 380px;
      max-width: 90%;
      box-shadow: 0 10px 40px rgba(0,0,0,0.25);
    }
    .platform-login-card h1 { text-align: center; margin-bottom: 2px; }
    .platform-login-card .sub { text-align: center; color: var(--ink-soft); font-size: 0.85rem; margin-bottom: 24px; }
    .operator-badge {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 4px;
      margin-bottom: 6px;
    }
  </style>
</head>
<body>
  <div class="platform-login-wrap">
    <div class="platform-login-card">
      <div style="text-align:center;"><span class="operator-badge">Platform Operator</span></div>
      <h1>Ledger</h1>
      <div class="sub">Sign in to multi-tenant control center</div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/platform/login">
        <div class="field">
          <label for="email">Platform Admin Email</label>
          <input type="email" id="email" name="email" required autofocus placeholder="admin@platform.com">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn" style="width:100%; justify-content:center; padding:11px;">Log in to Operator Portal</button>
      </form>
    </div>
  </div>
</body>
</html>
