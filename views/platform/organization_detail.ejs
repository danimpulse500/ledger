<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <div class="sidebar no-print">
      <div class="brand">Ledger
        <span class="co-name">Platform Control</span>
      </div>
      <nav>
        <a href="/platform">Overview</a>
        <a href="/platform/organizations" class="active">Organizations</a>
      </nav>
      <div class="spacer"></div>
      <div class="user-box">
        <div class="u-name"><%= currentPlatformAdmin ? currentPlatformAdmin.name : 'Operator' %></div>
        <div class="u-role">Super Admin</div>
        <form method="POST" action="/platform/logout">
          <button type="submit">Log out</button>
        </form>
      </div>
    </div>

    <div class="main">
      <div style="margin-bottom:12px;">
        <a href="/platform/organizations" class="text-faint">&larr; Back to Organizations</a>
      </div>

      <div class="topbar">
        <div>
          <h1><%= org.name %></h1>
          <p class="text-soft">
            slug: <code><%= org.slug %></code> &bull; 
            <span class="badge badge-sent"><%= org.plan %> plan</span> &bull; 
            <span class="badge <%= org.status === 'active' ? 'badge-paid' : 'badge-overdue' %>"><%= org.status %></span>
          </p>
        </div>

        <div class="actions" style="align-items:center;">
          <!-- Plan Form -->
          <form action="/platform/organizations/<%= org.id %>/plan" method="POST" style="margin:0;">
            <select name="plan" onchange="this.form.submit()" style="padding:6px 10px; width:auto;">
              <option value="starter" <%= org.plan === 'starter' ? 'selected' : '' %>>Starter Plan</option>
              <option value="pro" <%= org.plan === 'pro' ? 'selected' : '' %>>Pro Plan</option>
              <option value="enterprise" <%= org.plan === 'enterprise' ? 'selected' : '' %>>Enterprise Plan</option>
            </select>
          </form>

          <!-- Toggle Status Form -->
          <form action="/platform/organizations/<%= org.id %>/status" method="POST" style="margin:0;">
            <% if (org.status === 'active') { %>
              <input type="hidden" name="status" value="suspended">
              <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Suspend this organization?')">Suspend Access</button>
            <% } else { %>
              <input type="hidden" name="status" value="active">
              <button type="submit" class="btn btn-sm" style="background:var(--success)">Re-activate Account</button>
            <% } %>
          </form>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <div class="grid grid-4" style="margin-bottom:20px;">
        <div class="card stat-card">
          <div class="label">Invoices Count</div>
          <div class="value figure"><%= stats.invoice_count %></div>
        </div>
        <div class="card stat-card">
          <div class="label">Total Invoiced Volume</div>
          <div class="value figure ok">$<%= Number(stats.total_volume).toFixed(2) %></div>
        </div>
        <div class="card stat-card">
          <div class="label">Clients Count</div>
          <div class="value figure"><%= stats.client_count %></div>
        </div>
        <div class="card stat-card">
          <div class="label">Products & Services</div>
          <div class="value figure"><%= stats.product_count %></div>
        </div>
      </div>

      <!-- Members Card -->
      <div class="card" style="margin-bottom:20px;">
        <div class="section-title">
          <h2>Organization Members (<%= members.length %>)</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Joined</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(m => { %>
              <tr>
                <td>#<%= m.id %></td>
                <td><strong><%= m.name %></strong></td>
                <td><%= m.email %></td>
                <td><span style="text-transform:capitalize; font-weight:600; color:var(--ink-soft);"><%= m.role %></span></td>
                <td class="text-faint"><%= m.created_at.slice(0, 10) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Settings Summary -->
      <div class="card">
        <div class="section-title">
          <h2>Company Settings Summary</h2>
        </div>
        <div class="grid grid-3 text-soft" style="font-size:0.9rem;">
          <div><strong>Company Name:</strong> <%= settings ? settings.company_name : 'N/A' %></div>
          <div><strong>Currency Symbol:</strong> <%= settings ? settings.currency_symbol : '$' %></div>
          <div><strong>Invoice Prefix:</strong> <%= settings ? settings.invoice_prefix : 'INV-' %></div>
          <div><strong>Default Discount:</strong> <%= settings ? settings.default_tax_rate : 0 %>%</div>
          <div><strong>Tax / VAT ID:</strong> <%= (settings && settings.tax_id) ? settings.tax_id : 'None' %></div>
          <div><strong>Email Contact:</strong> <%= (settings && settings.email) ? settings.email : 'None' %></div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
