<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <div class="sidebar no-print">
      <div class="brand">Ledger
        <span class="co-name">Platform Control</span>
      </div>
      <nav>
        <a href="/platform" class="active">Overview</a>
        <a href="/platform/organizations">Organizations</a>
      </nav>
      <div class="spacer"></div>
      <div class="user-box">
        <div class="u-name"><%= currentPlatformAdmin ? currentPlatformAdmin.name : 'Operator' %></div>
        <div class="u-role">Super Admin</div>
        <form method="POST" action="/platform/logout">
          <button type="submit">Log out</button>
        </form>
      </div>
    </div>

    <div class="main">
      <div class="topbar">
        <div>
          <h1>Platform Dashboard</h1>
          <p class="text-soft">Overview of all tenant organizations and multi-tenant system health.</p>
        </div>
      </div>

      <div class="grid grid-4">
        <div class="card stat-card">
          <div class="label">Total Organizations</div>
          <div class="value figure"><%= metrics.total_orgs %></div>
          <div class="text-faint" style="margin-top:4px;">
            <span style="color:var(--success)"><%= metrics.active_orgs %> Active</span> &bull; 
            <span style="color:var(--danger)"><%= metrics.suspended_orgs %> Suspended</span>
          </div>
        </div>
        <div class="card stat-card">
          <div class="label">Registered Users</div>
          <div class="value figure"><%= metrics.total_users %></div>
        </div>
        <div class="card stat-card">
          <div class="label">Total Invoices</div>
          <div class="value figure"><%= metrics.total_invoices %></div>
        </div>
        <div class="card stat-card">
          <div class="label">Total Processed Volume</div>
          <div class="value figure ok">$<%= Number(metrics.total_volume).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div>
        </div>
      </div>

      <div class="grid grid-2" style="margin-top:20px; align-items:start;">
        <div class="card">
          <div class="section-title">
            <h2>Recent Organizations</h2>
            <a href="/platform/organizations" class="text-faint">View all &rarr;</a>
          </div>
          <% if (recentOrgs.length === 0) { %>
            <p class="text-soft">No organizations registered yet.</p>
          <% } else { %>
            <table>
              <thead>
                <tr>
                  <th>Organization</th>
                  <th>Plan</th>
                  <th>Status</th>
                  <th>Members</th>
                  <th>Invoices</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrgs.forEach(org => { %>
                  <tr>
                    <td>
                      <strong><%= org.name %></strong>
                      <div class="text-faint"><%= org.slug %></div>
                    </td>
                    <td><span class="badge badge-sent"><%= org.plan %></span></td>
                    <td>
                      <span class="badge <%= org.status === 'active' ? 'badge-paid' : 'badge-overdue' %>">
                        <%= org.status %>
                      </span>
                    </td>
                    <td><%= org.member_count %></td>
                    <td><%= org.invoice_count %></td>
                    <td><a href="/platform/organizations/<%= org.id %>" class="btn btn-sm btn-ghost">Manage</a></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="card">
          <div class="section-title">
            <h2>Subscription Plans Breakdown</h2>
          </div>
          <ul class="link-list">
            <% planStats.forEach(p => { %>
              <li style="display:flex; justify-content:space-between; align-items:center;">
                <div>
                  <span class="badge badge-sent" style="text-transform:capitalize;"><%= p.plan %> Plan</span>
                </div>
                <div class="figure" style="font-weight:700; font-size:1.1rem;"><%= p.count %> org(s)</div>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
