<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
</head>

<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('partials/sidebar') %>

    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <!-- ====== PAGE HEADER ====== -->
      <div class="flex justify-between items-end gap-5 mb-7">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 mb-1">Billing & Subscriptions</h1>
          <p class="text-slate-500 text-sm m-0">Manage your active plan, payment methods, and download payment receipts.</p>
        </div>
        <button type="button" class="inline-flex items-center gap-1.5 bg-slate-900 text-white font-semibold text-sm px-5 py-2.5 rounded-full cursor-pointer hover:bg-slate-800 transition-colors border-0 no-underline shadow-xs" onclick="triggerPaystackBillingModal()">Manage Subscription</button>
      </div>

      <!-- Flash Notification Message -->
      <% if (msg) { %>
        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm font-semibold flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-600">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span><%= msg %></span>
          </div>
          <button type="button" class="bg-transparent border-0 text-emerald-700 hover:text-emerald-900 font-bold cursor-pointer" onclick="this.parentElement.remove()">✕</button>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-900 text-sm font-semibold flex items-center justify-between shadow-xs">
          <div class="flex items-center gap-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-red-600">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><%= error %></span>
          </div>
          <button type="button" class="bg-transparent border-0 text-red-700 hover:text-red-900 font-bold cursor-pointer" onclick="this.parentElement.remove()">✕</button>
        </div>
      <% } %>

      <!-- ====== ACTIVE PLAN SUMMARY CARD ====== -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs mb-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-100">
          <div>
            <div class="flex items-center gap-2.5">
              <h3 class="text-lg font-bold text-slate-900 m-0"><%= plan.name %></h3>
              <% if (org && org.subscription_status === 'trialing') { %>
                <span class="bg-slate-900 text-white text-[0.68rem] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">30-Day Free Trial</span>
              <% } else if (org && org.subscription_status === 'active') { %>
                <span class="bg-emerald-100 text-emerald-800 text-[0.68rem] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">Active Subscription</span>
              <% } else { %>
                <span class="bg-amber-100 text-amber-800 text-[0.68rem] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full">Inactive</span>
              <% } %>
            </div>
            <p class="text-sm text-slate-500 mt-1 m-0"><%= plan.features %></p>
          </div>
          <div class="text-left md:text-right">
            <div class="text-2xl font-black text-slate-900"><%= plan.price %></div>
            <% if (org && org.trial_ends_at) { %>
              <div class="text-xs text-slate-500 mt-1">Trial Expiration: <strong><%= new Date(org.trial_ends_at).toLocaleDateString() %></strong></div>
            <% } %>
          </div>
        </div>

        <div class="pt-5 flex flex-wrap items-center justify-between gap-4">
          <div class="text-xs text-slate-500 font-medium">
            Next Renewal / Billing Date: <strong><%= org && org.trial_ends_at ? new Date(org.trial_ends_at).toLocaleDateString() : 'Active' %></strong>
          </div>
          <button type="button" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold px-4 py-2 rounded-full border-0 cursor-pointer transition-all shadow-xs" onclick="triggerPaystackBillingModal()">Update Billing Method</button>
        </div>
      </div>

      <!-- ====== PAYMENT & TRANSACTION HISTORY ====== -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs mb-6">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h3 class="text-base font-bold text-slate-900 m-0">Payment History & Receipts</h3>
            <p class="text-slate-500 text-xs mt-0.5 m-0">View all past subscription charges and download tax receipts.</p>
          </div>
          <span class="text-xs font-semibold text-slate-400"><%= typeof transactions !== 'undefined' ? transactions.length : 0 %> Record(s)</span>
        </div>

        <% if (typeof transactions === 'undefined' || transactions.length === 0) { %>
          <div class="py-8 text-center text-slate-500 text-sm bg-slate-50/50 rounded-xl border border-slate-100">
            <p class="m-0 font-medium">No payment history recorded yet.</p>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-xs">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider text-[0.68rem]">
                  <th class="py-3 px-3">Date</th>
                  <th class="py-3 px-3">Reference</th>
                  <th class="py-3 px-3">Description</th>
                  <th class="py-3 px-3">Payment Method</th>
                  <th class="py-3 px-3 text-right">Amount</th>
                  <th class="py-3 px-3 text-center">Status</th>
                  <th class="py-3 px-3 text-right">Receipt</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                <% transactions.forEach(tx => { %>
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-3.5 px-3 whitespace-nowrap"><%= new Date(tx.created_at).toLocaleDateString() %></td>
                    <td class="py-3.5 px-3 font-mono font-semibold text-slate-900"><%= tx.reference %></td>
                    <td class="py-3.5 px-3"><%= tx.description || 'Ledger Pro Plan' %></td>
                    <td class="py-3.5 px-3"><%= tx.card_brand || 'Card' %> •••• <%= tx.card_last4 || '4242' %></td>
                    <td class="py-3.5 px-3 text-right font-mono font-bold text-slate-900">
                      <% if (tx.amount === 0) { %>
                        <span class="text-emerald-700">₦0.00 (Trial)</span>
                      <% } else { %>
                        ₦<%= tx.amount.toFixed(2) %>
                      <% } %>
                    </td>
                    <td class="py-3.5 px-3 text-center">
                      <span class="bg-emerald-100 text-emerald-800 text-[0.65rem] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full">Paid</span>
                    </td>
                    <td class="py-3.5 px-3 text-right">
                      <a href="/billing/receipt/<%= tx.id %>/download" target="_blank" class="inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-700 font-semibold px-3 py-1.5 rounded-full text-[0.72rem] transition-all no-underline">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Receipt</span>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- ====== PAYMENT METHODS ON FILE ====== -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs mb-6">
        <div class="flex justify-between items-center mb-4">
          <div>
            <h3 class="text-base font-bold text-slate-900 m-0">Payment methods</h3>
            <p class="text-slate-500 text-xs mt-0.5 m-0">Credit card details connected for automated renewal.</p>
          </div>
          <button type="button" class="inline-flex items-center bg-transparent text-slate-900 border border-slate-900 px-3.5 py-1.5 text-xs font-semibold rounded-full hover:bg-slate-900 hover:text-white transition-all cursor-pointer" onclick="triggerPaystackBillingModal()">+ Add / Update Card</button>
        </div>

        <% if (paymentMethods.length === 0) { %>
          <div class="py-6 text-center text-slate-500 text-sm bg-slate-50/50 rounded-xl border border-slate-100">
            <p class="m-0 font-medium">No payment methods on file. <button type="button" onclick="triggerPaystackBillingModal()" class="text-slate-900 font-bold underline bg-transparent border-0 cursor-pointer">Add card details</button> to activate billing.</p>
          </div>
        <% } else { %>
          <div class="my-2 divide-y divide-slate-100">
            <% paymentMethods.forEach(method => { %>
              <div class="flex items-center py-3.5">
                <div class="w-10 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold text-[0.65rem] uppercase mr-3">
                  <%= method.brand %>
                </div>
                <div class="flex-1">
                  <strong class="block text-xs font-bold text-slate-900"><%= method.brand %> ending in <%= method.last4 %></strong>
                  <span class="text-[0.7rem] text-slate-500">Expires <%= method.exp %></span>
                  <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-[0.62rem] font-bold uppercase tracking-wider ml-2">Default Card</span>
                </div>
                <div>
                  <button type="button" class="bg-transparent text-slate-600 border border-slate-200 px-3 py-1 text-xs font-semibold rounded-full hover:bg-slate-100 hover:text-slate-900 cursor-pointer" onclick="triggerPaystackBillingModal()">Update Card</button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <%- include('partials/modals') %>
</body>

</html>