<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
</head>

<body>
    <div class="app-shell">
        <%- include('partials/sidebar') %>

            <div class="main">
                <!-- ====== PAGE HEADER ====== -->
                <div class="page-heading">
                    <div>
                        <!-- <p class="eyebrow">Subscription & usage</p> -->
                        <h1>Billing</h1>
                        <p class="text-soft">Manage your plan, payment methods, and view past invoices.</p>
                    </div>
                    <a href="/billing/upgrade" class="btn btn-black">Upgrade plan</a>
                </div>

            <!-- ====== PLAN & USAGE SUMMARY ====== -->
       
                <!-- ====== PAYMENT METHODS ====== -->
                <div class="card billing-payment-card mb-3">
                    <div class="section-title">
                        <div>
                            <h3>Payment methods</h3>
                            <p class="text-soft">Manage your credit cards and billing details.</p>
                        </div>
                        <button class="btn btn-ghost btn-sm" style="border: none !important;" onclick="addPaymentMethod()">+ Add method</button>
                    </div>

                    <% if (paymentMethods.length===0) { %>
                        <div class="empty-notice">
                            <p class="text-soft">No payment methods on file. <a href="/billing/payment">Add one</a> to
                                avoid service interruption.</p>
                        </div>
                        <% } else { %>
                            <div class="payment-methods-list">
                                <% paymentMethods.forEach(method=> { %>
                                    <div class="payment-method-item">
                                        <div class="payment-method-icon">
                                            <span class="card-icon <%= method.brand %>"></span>
                                        </div>
                                        <div class="payment-method-details">
                                            <strong>
                                                <%= method.brand %> ending in <%= method.last4 %>
                                            </strong>
                                            <span class="text-soft">Expires <%= method.expiry %></span>
                                            <% if (method.isDefault) { %>
                                                <span class="badge badge-default">Default</span>
                                                <% } %>
                                        </div>
                                        <div class="payment-method-actions">
                                            <button class="btn btn-ghost btn-sm"
                                                onclick="editPaymentMethod('<%= method.id %>')">Edit</button>
                                            <button class="btn btn-ghost btn-sm text-danger"
                                                onclick="deletePaymentMethod('<%= method.id %>')">Remove</button>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } %>

                                <div class="billing-address">
                                    <h4>Billing address</h4>
                                    <p>
                                        <%= billingAddress %>
                                    </p>
                                    <button class="btn" onclick="editBillingAddress()">Update
                                        address</button>
                                </div>
                </div>

                <!-- ====== INVOICE HISTORY ====== -->
                <!-- <div class="card billing-invoice-history">
                    <div class="section-title">
                        <div>
                            <h3>Invoice history</h3>
