<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="app-shell">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <%- include('partials/sidebar') %>
    <% } %>
    <div class="main">
      <div class="empty-state card">
        <h3><%= title %></h3>
        <p><%= message %></p>
        <a href="/" class="btn btn-outline">Back to dashboard</a>
      </div>
    </div>
  </div>
</body>
</html>
