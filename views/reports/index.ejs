<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-shell">
    <%- include('../partials/sidebar') %>
    <div class="main">
      <h1>Reports</h1>

      <div class="grid grid-4 stat-grid" style="margin-bottom:20px;">

        <!-- Total Invoiced -->
        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <div class="stat-number figure"><%= currencySymbol %><%= totals.total_invoiced.toFixed(2) %></div>
          </div>
          <div class="stat-bottom">Total Invoiced</div>
        </div>

        <!-- Total Collected -->
        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <div class="stat-number figure"><%= currencySymbol %><%= totals.total_collected.toFixed(2) %></div>
          </div>
          <div class="stat-bottom">Total Collected</div>
        </div>

        <!-- Net Profit -->
        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                <polyline points="17 6 23 6 23 12"/>
              </svg>
            </div>
            <div class="stat-number figure <%= netProfit >= 0 ? '' : 'text-danger' %>"><%= currencySymbol %><%= netProfit.toFixed(2) %></div>
          </div>
          <div class="stat-bottom">Net Profit <span class="text-faint">(collected − expenses)</span></div>
        </div>

        <!-- Client Count -->
        <div class="card stat-card-invoxa">
          <div class="stat-top">
            <div class="stat-icon-chip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="stat-number figure"><%= clientCount %></div>
          </div>
          <div class="stat-bottom">Total Clients</div>
        </div>

      </div>


      <div class="card">
        <h3>Revenue vs. expenses by month</h3>
        <% if (combined.length === 0) { %>
          <p class="text-soft">Not enough data yet.</p>
        <% } else { %>
          <table>
            <thead><tr><th>Month</th><th class="money">Revenue</th><th class="money">Expenses</th><th class="money">Net</th></tr></thead>
            <tbody>
              <% combined.forEach(m => { %>
                <tr>
                  <td class="figure"><%= m.month %></td>
                  <td class="money"><%= currencySymbol %><%= m.revenue.toFixed(2) %></td>
                  <td class="money"><%= currencySymbol %><%= m.expenses.toFixed(2) %></td>
                  <td class="money <%= (m.revenue - m.expenses) >= 0 ? '' : 'text-soft' %>"><%= currencySymbol %><%= (m.revenue - m.expenses).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="grid grid-2" style="margin-top:16px; align-items:start;">
        <div class="card">
          <h3>Outstanding invoices <span class="text-faint">(<%= currencySymbol %><%= outstandingTotal.toFixed(2) %> total)</span></h3>
          <% if (outstanding.length === 0) { %>
            <p class="text-soft">Nothing outstanding. All caught up.</p>
          <% } else { %>
            <table class="compact">
              <thead><tr><th>Invoice</th><th>Client</th><th>Due</th><th class="money">Balance</th></tr></thead>
              <tbody>
                <% outstanding.forEach(inv => { %>
                  <tr>
                    <td><a href="/invoices/<%= inv.id %>"><%= inv.invoice_number %></a></td>
                    <td><%= inv.client_name %></td>
                    <td><%= inv.due_date %></td>
                    <td class="money"><%= currencySymbol %><%= (inv.total - inv.amount_paid).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="card">
          <h3>Expenses by category</h3>
          <% if (expensesByCategory.length === 0) { %>
            <p class="text-soft">No expenses recorded yet.</p>
          <% } else { %>
            <table class="compact">
              <thead><tr><th>Category</th><th class="money">Total</th></tr></thead>
              <tbody>
                <% expensesByCategory.forEach(c => { %>
                  <tr><td><%= c.category %></td><td class="money"><%= currencySymbol %><%= c.total.toFixed(2) %></td></tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
