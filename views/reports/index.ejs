<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <div class="flex h-screen w-full overflow-hidden bg-slate-50">
    <%- include('../partials/sidebar') %>
    <div class="flex-1 p-8 max-w-7xl h-screen overflow-y-auto">
      <h1 class="text-2xl font-bold text-slate-900 mb-6">Reports</h1>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Total Invoiced -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-2">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= currencySymbol %><%= (Number(totals.total_invoiced) || 0).toFixed(2) %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Invoiced</div>
        </div>

        <!-- Total Collected -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-2">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= currencySymbol %><%= (Number(totals.total_collected) || 0).toFixed(2) %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Collected</div>
        </div>

        <!-- Net Profit -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-2">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                <polyline points="17 6 23 6 23 12"/>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight <%= netProfit >= 0 ? 'text-slate-900' : 'text-red-500' %>"><%= currencySymbol %><%= (Number(netProfit) || 0).toFixed(2) %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Net Profit <span class="text-slate-400 font-normal lowercase">(collected − expenses)</span></div>
        </div>

        <!-- Customer Count -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
          <div class="flex justify-between items-start mb-2">
            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="text-2xl font-bold tracking-tight text-slate-900"><%= clientCount %></div>
          </div>
          <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Customers</div>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs mb-6">
        <h3 class="text-base font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 m-0">Revenue vs. expenses by month</h3>
        <% if (combined.length === 0) { %>
          <p class="text-slate-500 text-sm m-0">Not enough data yet.</p>
        <% } else { %>
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                <th class="py-2.5 px-3">Month</th>
                <th class="py-2.5 px-3 font-mono text-right">Revenue</th>
                <th class="py-2.5 px-3 font-mono text-right">Expenses</th>
                <th class="py-2.5 px-3 font-mono text-right">Net</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% combined.forEach(m => { %>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-3 px-3 text-slate-800"><%= m.month %></td>
                  <td class="py-3 px-3 text-right text-slate-900"><%= currencySymbol %><%= (Number(m.revenue) || 0).toFixed(2) %></td>
                  <td class="py-3 px-3 text-right text-slate-900"><%= currencySymbol %><%= (Number(m.expenses) || 0).toFixed(2) %></td>
                  <td class="py-3 px-3 text-right font-semibold <%= (m.revenue - m.expenses) >= 0 ? 'text-slate-900' : 'text-slate-400' %>"><%= currencySymbol %><%= (Number(m.revenue || 0) - Number(m.expenses || 0)).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 m-0">
            Outstanding invoices <span class="text-slate-400 font-normal text-xs">(<%= currencySymbol %><%= (Number(outstandingTotal) || 0).toFixed(2) %> total)</span>
          </h3>
          <% if (outstanding.length === 0) { %>
            <p class="text-slate-500 text-sm m-0">Nothing outstanding. All caught up.</p>
          <% } else { %>
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                  <th class="py-2 px-2.5">Invoice</th>
                  <th class="py-2 px-2.5">Customer</th>
                  <th class="py-2 px-2.5">Due</th>
                  <th class="py-2 px-2.5 text-right">Balance</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% outstanding.forEach(inv => { %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-2.5 px-2.5"><a href="/invoices/<%= inv.id %>" class="font-semibold text-slate-900 no-underline hover:underline"><%= inv.invoice_number %></a></td>
                    <td class="py-2.5 px-2.5 text-slate-700"><%= inv.client_name %></td>
                    <td class="py-2.5 px-2.5 text-slate-500"><%= inv.due_date %></td>
                    <td class="py-2.5 px-2.5 text-right font-semibold text-slate-900"><%= currencySymbol %><%= (Number(inv.total || 0) - Number(inv.amount_paid || 0)).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs">
          <h3 class="text-base font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 m-0">Expenses by category</h3>
          <% if (expensesByCategory.length === 0) { %>
            <p class="text-slate-500 text-sm m-0">No expenses recorded yet.</p>
          <% } else { %>
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b-2 border-slate-200 text-left text-[0.74rem] uppercase tracking-wider text-slate-500 font-semibold">
                  <th class="py-2 px-2.5">Category</th>
                  <th class="py-2 px-2.5 text-right">Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% expensesByCategory.forEach(c => { %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-2.5 px-2.5 text-slate-800"><%= c.category %></td>
                    <td class="py-2.5 px-2.5 text-right font-semibold text-slate-900"><%= currencySymbol %><%= (Number(c.total) || 0).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
